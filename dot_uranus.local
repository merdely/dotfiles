# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.uranus.local
# Or after editing, run: chezmoi re-add ~/.uranus.local

case "$OSTYPE" in
  linux*)
    ;;
  openbsd*)
    export XDG_RUNTIME_DIR=/tmp/run/user/$UID
    run-ssh-agent
    if [ -z "$SSH_AUTH_SOCK" ] && [ -S "$HOME"/.ssh/agent/local-ssh-agent ]; then
      SSH_AUTH_SOCK="$HOME"/.ssh/agent/local-ssh-agent
      SSH_AGENT_PID=$(cat "$HOME"/.ssh/agent/local-ssh-agent.pid)
      export SSH_AUTH_SOCK SSH_AGENT_PID
    fi
    ;;
  *)
    ;;
esac

