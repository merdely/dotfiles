atuin:
  hosts:
    mercury:
    earth:
      atuin: $HOME/.local/bin/atuin
    jupiter:
      atuin: $HOME/.local/bin/atuin
    saturn:
      atuin: $HOME/.local/bin/atuin
    dia:
    cordelia:
    neptune:
    pluto:
      atuin: $HOME/.local/bin/atuin
    ceres:
      atuin: $HOME/.local/bin/atuin
    carme:
    metis:
    tarvos:
      atuin: $HOME/.local/bin/atuin
  vars:
    atuin: atuin

chezmoi:
  hosts:
    mercury:
    venus:
      ansible_python_interpreter: /opt/homebrew/bin/python3
      ansible_remote_tmp: /tmp/.ansible-mike/tmp
      chezmoi: /opt/homebrew/bin/chezmoi
    earth:
      chezmoi: $HOME/.local/bin/chezmoi
    jupiter:
      chezmoi: $HOME/.local/bin/chezmoi
    saturn:
      chezmoi: $HOME/.local/bin/chezmoi
    dia:
    cordelia:
    neptune:
    pluto:
      chezmoi: $HOME/.local/bin/chezmoi
    ceres:
      chezmoi: $HOME/.local/bin/chezmoi
    carme:
    metis:
    tarvos:
      chezmoi: $HOME/.local/bin/chezmoi
