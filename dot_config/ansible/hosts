# vim: set filetype=yaml :
# For the host running ansible, create a host_vars directory next to this file
# Create a file with the same name as the host and put in it:
# ---
# ansible_connection: localhost

chezmoi:
  hosts:
    mercury:
    venus:
      ansible_python_interpreter: /opt/homebrew/bin/python3
      chezmoi: /opt/homebrew/bin/chezmoi
    earth:
      chezmoi: $HOME/.local/bin/chezmoi
    jupiter:
      chezmoi: $HOME/.local/bin/chezmoi
    saturn:
      chezmoi: $HOME/.local/bin/chezmoi
    uranus:
    neptune:
    pluto:
    ceres:
      chezmoi: $HOME/.local/bin/chezmoi
    carme:
    metis:
    tarvos:
      chezmoi: $HOME/.local/bin/chezmoi
    sinope:
      chezmoi: $HOME/.local/bin/chezmoi
  vars:
    chezmoi: chezmoi

chezmoi_ro:
  hosts:
    carme:
    metis:
    tarvos:
    sinope:
