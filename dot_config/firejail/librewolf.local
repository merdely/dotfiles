# vim: set filetype=firejail :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.config/firejail/librewolf.local
# Or after editing, run: chezmoi re-add ~/.config/firejail/librewolf.local

noblacklist ${HOME}/.config/librewolf
mkdir ${HOME}/.config/librewolf
whitelist ${HOME}/.config/librewolf
