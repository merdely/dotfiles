local ok, plugin_config = pcall(require, "mini.clue")
if ok then
  plugin_config.setup({
    window = {
      delay = 200,
    },
    triggers = {
      { mode = { "n", "x" }, keys = "<leader>" },
      { mode = "n", keys = "[" },
      { mode = "n", keys = "]" },
      { mode = "i", keys = "C-x>" },
      { mode = { "n", "x" }, keys = "g" },
      { mode = { "n", "x" }, keys = "'" },
      { mode = { "n", "x" }, keys = "`" },
      { mode = { "n", "x" }, keys = '"' },
      { mode = { "i", "c" }, keys = "<C-r>" },
      { mode = "n", keys = "<C-w>" },
      { mode = { "n", "x" }, keys = "z" },
    },
    clues = {
      plugin_config.gen_clues.square_brackets(),
      plugin_config.gen_clues.builtin_completion(),
      plugin_config.gen_clues.g(),
      plugin_config.gen_clues.marks(),
      plugin_config.gen_clues.registers(),
      plugin_config.gen_clues.windows(),
      plugin_config.gen_clues.z(),
      { mode = { "n" }, keys="<leader>b", desc = "Buffer"},
      { mode = { "n" }, keys="<leader>c", desc = "Code"},
      { mode = { "n" }, keys="<leader>s", desc = "Search"},
      { mode = { "n" }, keys="<leader>u", desc = "UI/Update"},
      { mode = { "n" }, keys="gs", desc = "Surround"},
    },
  })
end
