# vim: set filetype=dosini :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.config/foot/foot.ini
# Or after editing, run: chezmoi re-add ~/.config/foot/foot.ini

[colors-light]
alpha=0.8
[colors-dark]
alpha=0.8

[main]
login-shell=yes
font=monospace:size=11
pad=4x4
{{ if eq .chezmoi.os "openbsd" -}}
include=/usr/local/share/foot/themes/kitty
{{ else -}}
include=/usr/share/foot/themes/kitty
{{ end -}}

# Include a file named $hostname.ini
include=~/.config/foot/{{ .chezmoi.hostname }}.ini

