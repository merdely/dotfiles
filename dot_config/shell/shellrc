# Copy contents of a file to the clipboard
copy () {
  input="${1:--}"
  [ "$input" != "-" ] && [ ! -r "$input" ] && input=-
  text=$(cat "$input")

  if [ -n "$SSH_CONNECTION" ]; then
    b64=$(printf '%s' "$text" | base64 -w0 - | tr -d '\n')
    printf '\033]52;c;%s\a' "$b64"
  else
    printf '%s' "${text%$'\n'}" | wl-copy
  fi
}

