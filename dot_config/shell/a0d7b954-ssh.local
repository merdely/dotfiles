# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.a0d7b954-ssh.local
# Or after editing, run: chezmoi re-add ~/.a0d7b954-ssh.local

# This is the .profile.local for the Home Assistant SSH Add-On

alias ls='ls -F'

[ -z "$PROFILE_READ" ] && cd /config
PROFILE_READ=true

if [ -n "$ZSH_VERSION" ]; then
  PROMPT='${PRE_PROMPT}%B[%F{cyan}%n%f@%F{green}hass%f %F{blue}%(3~,${dots}/,)%2~%f]${subshell}'
  command -v __git_ps1 &> /dev/null && PROMPT="$PROMPT"'$(__git_ps1 " (%%F{${git_c}}${git_s}%%f %s)")'
  PROMPT="$PROMPT"' %F{blue}%(!.#.${pchar})%f%b '
else
  PS1="[\[${c_cyan}\]\u\[${c_reset}\]@\[${c_green}\]hass\[${c_reset}\] \[${c_blue}\]\$(__prompt_trim_pwd "\W")\[${c_reset}\]]\[\e[22;24;27;49m\]${__shellind}${__subshell}\$(__git_ps1 ' (\[\e[1m${c_orange}\]${__gitglyph}\[${c_reset}\]%s\[\e[22m\])' 2>/dev/null) ${__nl}\[\${__prompt_color}\]${__promptchar}\[${c_reset}\] \[\e[0m\]"
fi
