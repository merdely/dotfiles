# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.dia.local
# Or after editing, run: chezmoi re-add ~/.dia.local

case "$OSTYPE" in
  linux*)
    ;;
  openbsd*)
    export XDG_RUNTIME_DIR=/tmp/run/user/$UID
    run-ssh-agent >/dev/null 2>&1

    if [ -z "$SSH_CONNECTION" ] && [ -S "$HOME"/.ssh/agent/local-ssh-agent ]; then
      SSH_AUTH_SOCK="$HOME"/.ssh/agent/local-ssh-agent
      SSH_AGENT_PID=$(cat "$HOME"/.ssh/agent/local-ssh-agent.pid)
      export SSH_AUTH_SOCK SSH_AGENT_PID
    fi

    alias watch=gnuwatch
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export LC_CTYPE=C.UTF-8
    export RBW_PINENTRY=fuzzel
    ;;
  *)
    ;;
esac

