// vim: set filetype=kdl :
// NOTE: Do not edit this file directly
// Use: chezmoi edit ~/.config/niri/mercury.kdl
// Or after editing, run: chezmoi re-add ~/.config/niri/mercury.kdl

output "eDP-1" {
    position x=0 y=0
}

output "DP-1" {
    focus-at-startup
    position x=1920 y=0
}

output "HDMI-A-1" {
    position x=3840 y=0
}

binds {
//     Mod+Shift+d  hotkey-overlay-title="Terminal File Manager"  { spawn-sh "$HOME/.config/niri/new_scratchpad termfm"; }
    Mod+Ctrl+Comma      hotkey-overlay-title="System Monitor"   { spawn-sh "$HOME/.config/niri/scratchpad htop-earth"; }
    Mod+Ctrl+Period     hotkey-overlay-title="GPU Monitor"      { spawn-sh "$HOME/.config/niri/scratchpad nvtop-earth"; }
}

// Fix for nvidia card
debug { wait-for-frame-completion-before-queueing; }
