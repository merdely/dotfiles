#!/usr/bin/env bash

options=(
  Lock
  Logout
  Reboot
  Shutdown/Halt
)

command=$(printf '%s\n' "${options[@]}" | fuzzel -d)

case "$command" in
  Lock) "$HOME"/.config/waybar/scripts/idle-inhibitor disable ; swaylock -f -c 000000 ;;
  Logout) "$HOME"/config/waybar/scripts/idle-inhibitor disable ; niri msg action quit ;;
  Reboot) notify-send "Rebooting" ; "$HOME"/config/waybar/scripts/idle-inhibitor disable ; /sbin/shutdown -r now ;;
  Shutdown/Halt) notify-send "Shutting Down" ; "$HOME"/config/waybar/scripts/idle-inhibitor disable ; /sbin/shutdown -h now ;;
  *) ;;
esac
