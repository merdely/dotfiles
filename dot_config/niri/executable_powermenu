#!/usr/bin/env bash

options=(
  Lock
  Logout
  Reboot
  Shutdown
)

command=$(printf '%s\n' "${options[@]}" | fuzzel -d)

case "$command" in
  Lock) "$HOME"/.config/waybar/scripts/idle-inhibitor disable ; swaylock -f -c 000000 ;;
  Logout) config/waybar/scripts/idle-inhibitor disable ; niri msg action quit ;;
  Reboot) config/waybar/scripts/idle-inhibitor disable ; doas /sbin/reboot ;;
  Shutdown) config/waybar/scripts/idle-inhibitor disable ; doas /sbin/halt -p ;;
  *) ;;
esac
