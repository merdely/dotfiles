// vim: set filetype=kdl :
// NOTE: Do not edit this file directly
// Use: chezmoi edit ~/.config/niri/uranus.kdl
// Or after editing, run: chezmoi re-add ~/.config/niri/uranus.kdl

spawn-sh-at-startup "kitty"


{{ if eq .chezmoi.os "openbsd" -}}
spawn-sh-at-startup "waybar"
spawn-sh-at-startup "swayidle -w"
spawn-sh-at-startup "dunst"
spawn-sh-at-startup "syncthing --no-browser"
spawn-sh-at-startup "ssh-add -l || ssh-add < /dev/null"

environment {
  RBW_PINENTRY "fuzzel"
}

// To override a previous definition, the same key name must be used (Super/Mod)
binds {
    Mod+T                hotkey-overlay-title="Open Terminal"     { spawn-sh "kitty"; }
    Mod+Space            hotkey-overlay-title="Fuzzel Apps"       { spawn-sh "fuzzel"; }
    Super+X              hotkey-overlay-title="Power Menu"        { spawn-sh "$HOME/.config/niri/powermenu"; }
    Mod+Shift+Space      hotkey-overlay-title="Clear Notifications" { spawn-sh "dunstctl close-all" ; }
    Mod+Alt+L            hotkey-overlay-title="Lock Screen"       { spawn-sh "swaylock -f -c 000000"; }
    Mod+Semicolon        hotkey-overlay-title="Run rbw-menu"      { spawn-sh "~/.local/bin/rbw-menu"; }
    Mod+Apostrophe       hotkey-overlay-title="Toggle Idle Inhibitor" { spawn-sh "~/.config/waybar/scripts/idle-inhibitor toggle"; }
}
{{ end -}}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

layout {
    focus-ring { off; }
    border {
        width 2
        active-color "#3daee9"
        inactive-color "#31363b"
        urgent-color "#9b0000"
    }
}

input {
    touchpad {
        tap
        dwt
        click-method "clickfinger"
    }
    focus-follows-mouse max-scroll-amount="49%"
}
