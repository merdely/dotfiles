#!/usr/bin/env bash
# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.local/bin/vm
# Or after editing, run: chezmoi re-add ~/.local/bin/vm

CONNECT_URI="qemu:///system"
ISO_PATH=/share/software/Isos
# _LIB="/../lib"            # comment this line out if parseopts.sh is in the same directory as $0
# _LIBDIR=/srv/scripts/lib  # Use a line like this to override location of parseopts.sh
PARSEOPTS="${_LIBDIR:-"$(dirname "$0")${_LIB:-}"}/parseopts.sh"
# shellcheck disable=SC1090,SC1091
source "$PARSEOPTS" ; unset _LIB _LIBDIR

command -v virsh &>/dev/null || { echo "Error: virsh is required for this program" >&2 ; exit 1 ; }

MAIN_MENU=(
  "Start VM(s)"
  "Stop VM(s)"
  "List VMs"
  "VM Console"
  "Create VM"
  "Clone VM"
  "VM Snapshots"
  "Reboot VM(s)"
  "Reset VM(s)"
  "Delete VM(s)"
  "Quit"
)

VM_TYPES=(
  "Arch Linux (arch)"
  "Debian (debian)"
  "Fedora (fedora)"
  "OpenBSD (openbsd)"
  "Oracle Enterprise Linux 9 (oel9)"
)

GUM_STYLE=(
  --header.foreground=33
)

clone_usage() {
  echo "usage: ${0##*/} clone [Options] SRC_VM DEST_VM"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -s|--start          : Start new VM after clone"
  echo "  -S|--start-console  : Start new VM after clone and connect to the console"
  exit "${1:-0}"
}

clone() {
  command -v virt-clone &>/dev/null || { echo "Error: virt-clone is required for this program" >&2 ; exit 1 ; }

  local src_vm="" dest_vm=""
  local connect=$CONNECT_URI start=false opts=()
  local OPT_SHORT="huc:sS"
  local OPT_LONG=("help" "user" "session" "connect:" "start" "start-console")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET

  while true; do
    case $1 in
      -h|--help) clone_usage ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -s|--start) start=true ;;
      -S|--start-console) start=true ; [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done
  src_vm=$1 dest_vm=$2

  (( $# != 2 )) && clone_usage 1
  [[ -z "$src_vm" || -z "$dest_vm" ]] && { main_menu clone ; exit ; }

  virt-clone --connect "${connect:-$CONNECT_URI}" --auto-clone --original "$src_vm" --name "$dest_vm"
  $start && virsh --connect "${connect:-$CONNECT_URI}" start "$dest_vm" "${opts[@]}" || true
}

create_usage() {
  echo "usage: ${0##*/} create [Options]"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -n|--name NAME      : Name for the VM (default: ${1:-vm_type})"
  echo "  -r|--name SIZE      : RAM SIZE in MB (default: $vm_ram MB)"
  echo "  -v|--cpus COUNT     : VCPU COUNT (default $vm_vcpus)"
  echo "  -d|--disk SIZE      : Disk SIZE in GB (default: $vm_disk GB)"
  echo "  -i|--iso ISO        : ISO path (default: latest iso in $ISO_PATH for vm_type)"
  echo "  -g|--disable-gpu    : Disable GPU mode"
  echo "  -t|--emulated-tpm   : Add emulated TPM module"
  echo "  -T|--test           : Test mode (print command instead of running it)"
  echo "  -s|--start          : Start VM after creation"
  echo "  -S|--start-console  : Start VM after creation and connect to the console"
  echo
  echo "VM Type Options:"
  echo "  -A|--arch           : Arch Linux"
  echo "  -D|--debian         : Debian"
  echo "  -F|--fedora         : Fedora"
  echo "  -O|--openbsd        : OpenBSD"
  echo "  -Q|--ol9            : Oracle Enterprise Linux 9"
  echo
  echo "One VM Type Option is required"
  exit "${1:-0}"
}
create() {
  command -v virt-install &>/dev/null || { echo "Error: virt-install is required for this program" >&2 ; exit 1 ; }

  local vm_name="" vm_ram=8192 vm_vcpus=2 vm_disk=20 vm_iso=""

  # shellcheck disable=1091
  [[ -r "$HOME"/.config/newvmrc ]] && source "$HOME"/.config/newvmrc

  local testmode="" vm_type="" tpm_mode=()
  local gpu_mode=(
    "--graphics" "spice,listen=none"
    "--graphics" "egl-headless,gl.rendernode=/dev/dri/by-path/pci-0000:00:02.0-render"
    "--video" "model=virtio,accel3d=yes"
  )

  local connect=$CONNECT_URI
  local OPT_SHORT="hcu:ADFOQn:r:v:d:i:gtTsS"
  local OPT_LONG=("help" "user" "session" "connect:" "name:" "ram:" "cpus:"
    "disk:" "iso:" "disable-gpu" "tpm" "emulated-tpm" "test" "start" "start-console"
    "arch" "archlinux" "debian" "fedora" "openbsd" "ol9" "oraclelinux9"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) create_usage ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -n|--name) shift ; vm_name=$1 ;;
      -r|--ram)  shift ; vm_ram=$1 ;;
      -v|--cpus) shift ; vm_vcpus=$1 ;;
      -d|--disk) shift ; vm_disk=$1 ;;
      -i|--iso)  shift ; vm_iso=$1 ; ;;
      -g|--disable-gpu) gpu_mode=("--video" "virtio") ;;
      -t|--tpm|--emulated-tpm) tpm_mode=(--tpm "backend.type=emulator,backend.version=2.0,backend.profile.source=default-v1,model=tpm-crb") ;;
      -T|--test) testmode="echo" ;;
      -s|--start) start=true ;;
      -S|--start-console) start=true ; [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
      -A|--arch|--archlinux) vm_type=arch ;;
      -D|--debian) vm_type=debian ;;
      -F|--fedora) vm_type=fedora ;;
      -G|--fedora-server) vm_type=fedora-server ;;
      -K|--fedora-kde) vm_type=fedora-kde ;;
      -O|--openbsd) vm_type=openbsd ;;
      -Q|--ol9|--oraclelinux9) vm_type=ol9 ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done
  vm_name=$1

  [[ -z "$vm_type" ]] && { main_menu create ; exit ; }

  # Get system information
  local sys_ram="" sys_proc="" sys_disk=""
  sys_ram=$(free -m | awk '/^Mem:/{print $2}')
  if [[ ! "$sys_ram" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system RAM"
    exit 1
  fi
  if command -v nproc &> /dev/null; then
    sys_proc=$(nproc)
  elif [[ -r /proc/cpuinfo ]]; then
    sys_proc=$(grep -Ec "^processor[[:space:]]*:")
  fi
  if [[ ! "$sys_proc" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system cpu count"
    exit 1
  fi
  sys_disk=$(df -k --output=avail /var/lib/libvirt/images | tail -n1)
  if [[ ! "$sys_disk" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system disk availability"
    exit 1
  fi

  # Validate RAM
  if [[ ! "$vm_ram" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: RAM must be numeric ($vm_ram)"
    exit 1
  elif (( vm_ram > sys_ram - 5 )); then
    echo "Error: Not enough system RAM for $vm_ram MB ($sys_ram MB on system)"
    exit 1
  elif (( vm_ram > sys_ram * 2 / 3 )); then
    echo "Warning: Using more than 2/3 system ram ($vm_ram of $sys_ram MB)"
  fi

  # Validate CPU count
  if [[ ! "$vm_vcpus" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: VCPU count must be numeric ($vm_vcpus)"
    exit 1
  elif (( vm_vcpus > sys_proc )); then
    echo "Error: VCPU count greater than system cpu count ($vm_vcpus > $sys_proc)"
    exit 1
  fi

  # Validate Disk size
  if [[ ! "$vm_disk" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Disk size must be numeric ($vm_disk)"
    exit 1
  elif (( vm_disk > sys_disk - 20 )); then
    echo "Error: Disk size of $vm_disk GB uses too much of $sys_disk GB available"
    exit 1
  fi

  # Validate ISO directory
  local iso_found=false iso=""
  for iso in "$ISO_PATH"/*.iso; do
    iso_found=true
    break
  done
  [[ ! -d "$ISO_PATH" ]] && { echo "Error: Could not find $ISO_PATH" ; exit 1 ; }
  if ! $iso_found; then
    echo "Error: Could not find any ISO files in $ISO_PATH"
    exit 1
  fi

  local os_variant="" vm_label="" os_search="" iso_search="" install_flags=()
  case "$vm_type" in
    "Arch Linux"|arch)
      vm_label="Arch Linux"
      os_search=archlinux
      iso_search="archlinux-*.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=arch/boot/x86_64/vmlinuz-linux,initrd=arch/boot/x86_64/initramfs-linux.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "archisodevice=/dev/sr0"
      )
      ;;
    Debian|debian)
      vm_label=Debian
      os_search=debian
      iso_search="debian-*-netinst.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso"
        "--extra-args" "console=ttyS0,115200n8 --- console=ttyS0,115200n8"
      )
      ;;
    Fedora|fedora)
      vm_label="Fedora"
      os_search='fedora'
      iso_search="Fedora-Everything-netinst-x86_64-*.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=images/pxeboot/vmlinuz,initrd=images/pxeboot/initrd.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "inst.text"
      )
      ;;
    OpenBSD|openbsd)
      vm_label=OpenBSD
      os_search=openbsd
      iso_search="openbsd-install*-serial.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=( "--cdrom" "$vm_iso" )
      ;;
    "Oracle Enterprise Linux 9"|ol9)
      vm_label="Oracle Enterprise Linux"
      os_search='ol9\\.'
      iso_search="OracleLinux-R9-U*-x86_64-boot-uek.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=images/pxeboot/vmlinuz,initrd=images/pxeboot/initrd.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "inst.text"
      )
      ;;
    *)
      echo "Error: Invalid VM Type" >&2
      exit 1
      ;;
  esac

  os_variant=$(get_os_variant "$os_search")
  echo "Installing a new $vm_label VM: name=$vm_name, ram=$vm_ram, disk=$vm_disk, cpu=$vm_vcpus"

  $testmode virt-install --connect "${connect:-$CONNECT_URI}" \
    --os-variant "$os_variant" --name "$vm_name" --ram "$vm_ram" --vcpus "$vm_vcpus" \
    --disk path=/var/lib/libvirt/images/"$vm_name".qcow2,size="$vm_disk",format=qcow2 \
    --vsock cid.auto=yes --boot uefi "${gpu_mode[@]}" "${tpm_mode[@]}" --autoconsole text \
    "${install_flags[@]}"
}

delete_usage() {
  echo "usage: ${0##*/} delete [Options] VM_TO_DELETE.."
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Do not prompt for confirmation"
  exit "${1:-0}"
}

delete() {
  local force=false pronoun=its vmlabel=VM vm="" REPLY="" snapshots=() snapshot=""
  local connect=$CONNECT_URI
  local OPT_SHORT="huc:f"
  local OPT_LONG=("help" "user" "session" "connect:" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) delete_usage ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && { main_menu delete ; exit ; }
  (( $# > 1 )) && { pronoun=their ; vmlabel=VMs ; }

  if ! "$force"; then
    read -rp "Really delete $vmlabel ($*) and $pronoun storage? [yN] "
    if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
      echo "Not deleting $vmlabel: $*"
      exit
    fi
    echo
  fi

  for vm in "$@"; do
    if ! grep -q "shut off" < <(virsh --connect "${connect:-$CONNECT_URI}" domstate "$vm"); then
      virsh --connect "${connect:-$CONNECT_URI}" destroy "$vm"
    fi
    mapfile -t snapshots < <(virsh --connect "${connect:-$CONNECT_URI}" snapshot-list --name "$vm"|grep .)
    for snapshot in "${snapshots[@]}"; do
      virsh --connect "${connect:-$CONNECT_URI}" snapshot-delete "$vm" "$snapshot"
    done
    virsh --connect "${connect:-$CONNECT_URI}" undefine "$vm" --nvram --remove-all-storage
  done
}

list_usage() {
  echo "usage: ${0##*/} list [Options]"
  echo
  echo "Options:"
  echo "  -h|--help             : This help text"
  echo "  -u|--user|--session   : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI      : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "     --gui              : Use GUI Mode"
  echo "  -a|--all              : Print all VMs (default action)"
  echo "  -A|--autostart        : Print VMs set to autostart"
  echo "  -r|--running          : Print running VMs"
  echo "  -o|--stopped          : Print off/stopped VMs"
  echo "  -p|--paused           : Print paused VMs"
  echo "  -s|--with-snapshot    : Print VMs with snapshot"
  echo "  -S|--without-snapshot : Print VMs without snapshot"
  echo "  -i|--list-ips         : List DHCP IP Address List"
  echo "                          Pass a network name on the command line (default: 'default')"
  exit "${1:-0}"
}

list() {
  local opts=() mode=list
  local connect=$CONNECT_URI
  local OPT_SHORT="huc:aAropsSi"
  local OPT_LONG=(
    "help" "user" "session" "connect:" "all" "autostart" "running" "on" "gui"
    "off" "shutoff" "stopped" "paused" "with-snapshot" "without-snapshot" "list-ips"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) list_usage ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -a|--all) [[ " ${opts[*]} " != *" --all "* ]] && opts+=(--all) ; mode=all ;;
      -A|--autostart) [[ " ${opts[*]} " != *" --autostart "* ]] && opts+=(--autostart) ;;
      -r|--on|--running) [[ " ${opts[*]} " != *" --state-running "* ]] && opts+=(--state-running) ;;
      -o|--off|--stopped|--shutoff) [[ " ${opts[*]} " != *" --state-shutoff "* ]] && opts+=(--state-shutoff) ;;
      -p|--paused) [[ " ${opts[*]} " != *" --state-paused "* ]] && opts+=(--state-paused) ;;
      -s|--with-snapshot) [[ " ${opts[*]} " != *" --with-snapshot "* ]] && opts+=(--with-snapshot) ;;
      -S|--without-snapshot) [[ " ${opts[*]} " != *" --without-snapshot "* ]] && opts+=(--without-snapshot) ;;
      -i|--list-ips) mode=ip ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( ${#opts[@]} == 0 )) && [[ "$mode" != ip ]] && { opts+=(--all) ; mode=all ; }

  if [[ "$mode" == ip ]]; then
    virsh --connect "${connect:-$CONNECT_URI}" net-dhcp-leases "${1:-default}"
    exit
  fi

  virsh --connect "${connect:-$CONNECT_URI}" list "${opts[@]}"
}

reboot_usage() {
  local label=${1:-reboot}
  shift
  echo "usage: ${0##*/} $label [Options] VM_NAME"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Do not ask for confirmation before ${label}ing"
  exit "${1:-0}"
}

reboot() {
  local mode=reboot mode_label=Reboot force=false pronoun=its vmlabel=VM vm="" REPLY=""
  local connect=$CONNECT_URI
  local OPT_SHORT="hucf:"
  local OPT_LONG=("help" "reset" "user" "session" "connect:" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      --reset) mode=reset ; mode_label="Hard Reset" ;;
      -h|--help) reboot_usage ${mode:-reboot} ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && { main_menu "$mode" ; exit ; }
  if ! "$force"; then
    read -rp "Really $mode_label $vmlabel ($*)? [yN] "
    if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
      echo "Not ${mode}ing $vmlabel: $*"
      exit
    fi
    echo
  fi

  for vm in "$@"; do
    virsh --connect "${connect:-$CONNECT_URI}" $mode "$vm"
  done
}

snapshot_usage() {
  echo "usage: ${0##*/} snapshot [Options] VM_NAME.."
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Force delete with -D"
  echo "  -n|--name           : Snapshot name (default: 'Snapshot yyyy-mm-dd HH:MM:SS')"
  echo "  -d|--description DESCR : Snapshot description (default: none)"
  echo "  -l|--list           : List snapshots for VM_NAME"
  echo "  -t|--list-tree      : List snapshots for VM_NAME (tree)"
  echo "  -D|--delete         : Delete SNAPSHOT_NAME snapshot for VM_NAME (requires --name)"
  echo "  -R|--revert         : Revert/restore VM_NAME to SNAPSHOT_NAME (requires --name)"
  echo "Note: For -l, -t, -D, and -R, only one VM will be processed"
  exit "${1:-0}"
}

snapshot() {
  local mode=create vm="" snapshot_default="" description="" force=false REPLY=""
  local desc=() disks=() disk_opt=() disk="" mem_opt=()
  local connect=$CONNECT_URI
  local OPT_SHORT="huc:fn:d:ltDR"
  local OPT_LONG=(
    "help" "user" "session" "connect:" "force" "name:" "description:"
    "list" "list-tree" "delete" "revert"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  snapshot_default="Snapshot $(date +"%Y-%m-%d %H:%M:%S")"
  while true; do
    case $1 in
      -h|--help) snapshot_usage ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -n|--name) shift ; snapshot=$1 ;;
      -d|--description) shift ; description=$1 ;;
      -f|--force) force=true ;;
      -l|--list) mode=list ;;
      -t|--list-tree) mode="list-tree" ;;
      -D|--delete) mode=delete ;;
      -R|--revert) mode=revert ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  [[ -z "$snapshot" ]] && snapshot=$snapshot_default
  (( $# < 1 )) && { main_menu snapshot ; exit ; }

  if [[ "$mode" == list ]]; then
    virsh --connect "${connect:-$CONNECT_URI}" snapshot-list "$1"
    return
  elif [[ "$mode" == list-tree ]]; then
    virsh --connect "${connect:-$CONNECT_URI}" snapshot-list "$1" --tree
    return
  fi

  if [[ "$mode" == delete ]]; then
    if [[ -z "$snapshot" ]]; then
      echo "Error: SNAPSHOT_NAME must be provided when using -D" >&2
      exit 1
    fi
    if ! "$force"; then
      read -rp "Really delete snapshot '$snapshot' for $1? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not deleting '$snapshot' for $1"
        exit
      fi
      echo
    fi
    virsh --connect "${connect:-$CONNECT_URI}" snapshot-delete "$1" "$snapshot"
    return
  fi

  if [[ "$mode" == revert ]]; then
    if [[ -z "$snapshot" ]]; then
      echo "Error: SNAPSHOT_NAME must be provided when using -R" >&2
      exit 1
    fi
    if ! "$force"; then
      read -rp "Really revert $vm to snapshot '$snapshot'? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not reverting $1 to '$snapshot'"
        exit
      fi
      echo
    fi
    virsh --connect "${connect:-$CONNECT_URI}" snapshot-revert "$1" "$snapshot"
    return
  fi

  for vm in "$@"; do
    mapfile -t disks < <(virsh --connect "${connect:-$CONNECT_URI}" domblklist "$vm" --details | awk '$1=="file" && $2=="disk" {print $3}')

    for disk in "${disks[@]}"; do
      disk_opt+=(--diskspec "$disk,snapshot=external")
    done
    if (( ${#disk_opt[@]} == 0 )); then
      echo "Error: Could not determine disks for $vm" >&2
      exit 1
    fi

    if [[ -n "$description" ]]; then
      desc=(--description "$description")
    fi

    # shellcheck disable=SC2174
    [[ ! -d /var/lib/libvirt/qemu/snapshot/"$vm" ]] &&
      mkdir -m 775 -p /var/lib/libvirt/qemu/snapshot/"$vm"

    if ! grep -q "shut off" < <(virsh --connect "${connect:-$CONNECT_URI}" domstate "$vm"); then
      mem_opt=(--memspec "/var/lib/libvirt/qemu/snapshot/$vm/$snapshot-memory,snapshot=external")
    fi

    virsh --connect "${connect:-$CONNECT_URI}" snapshot-create-as "$vm" --name "$snapshot" "${desc[@]}" \
      --atomic "${disk_opt[@]}" "${mem_opt[@]}"
  done
}

start_usage() {
  local label=${1:-start}
  shift
  echo "usage: ${0##*/} $label [Options] VM_NAME.."
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  [[ "$label" == start ]] && echo "  -C|--console        : Start and attach to console"
  [[ "$label" == stop  ]] && echo "  -f|--force          : Stop VM(s) without prompting"
  exit "${1:-0}"
}

start() {
  local mode=start mode_label=Start command=start force=false vmlabel=VM opts=()
  local connect=$CONNECT_URI
  local OPT_SHORT="huc:Cf"
  local OPT_LONG=("help" "stop" "join-console" "user" "session" "connect:" "console" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      --stop) mode=stop ; mode_label=Stop ; command=destroy ;;
      --join-console) mode=console ; mode_label=Console ; command=console ;;
      -h|--help) start_usage "${mode:-start}" ;;
      -u|--user|--session) connect=qemu:///session ;;
      -c|--connect) shift ; connect=$1 ;;
      -C|--console) opts+=(--console) ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && { main_menu "$mode" ; exit ; }
  if [[ "$mode" == stop ]] && ! "$force"; then
    read -rp "Really $mode_label $vmlabel ($*)? [yN] "
    if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
      echo "Not ${mode}ing $vmlabel: $*"
      exit
    fi
    echo
  fi

  if (( $# > 1 )) && [[ "$mode" == start && " ${opts[*]} " == *" --console "* ]]; then
    echo "Warning: Cannot automatically attach to the console when ${mode}ing multiple VMs" >&2
    local new_opts=() item=""
    for item in "${opts[@]}"; do
      [[ "$item" != --console ]] && new_opts+=("$item")
    done
    opts=("${new_opts[@]}")
  fi
  [[ "$mode" == stop ]] && opts=()

  for vm in "$@"; do
    virsh --connect "${connect:-$CONNECT_URI}" "$command" "$vm" "${opts[@]}"
  done
}

get_os_variant() {
  command -v virt-install &>/dev/null || { echo "Error: virt-install is required for this program" >&2 ; exit 1 ; }

  (( $# < 1 )) && { echo "usage: get_os_variant SEARCHSTRING" ; return 1 ; }
  virt-install --osinfo list | \
    awk -F, -v os="$1" '$0 ~ "^" os "([[:digit:]]|$)" { print $1 }' | \
    sort -V | \
    tail -n1
}

get_iso() {
  (( $# < 1 )) && { echo "usage: get_iso ISOSEARCH [VM_ISO]" ; return 1 ; }
  local iso_search=$1 vm_iso=$2 ng=false
  if [[ -z "$vm_iso" ]]; then
    shopt -q nullglob && ng=true ; shopt -u nullglob
    for iso in "$ISO_PATH"/$iso_search; do
      vm_iso=$(printf "%s\n%s\n" "$vm_iso" "$iso" | grep . | sort -V | tail -n1)
    done
    $ng && shopt -s nullglob ; ng=false
  fi
  [[ -z "$vm_iso"   ]] && { echo "Error: ISO not defined" ; exit 1 ; }
  [[ ! -r "$vm_iso" ]] && { echo "Error: ISO not found"   ; exit 1 ; }
  echo "$vm_iso"
}

sub_menu() {
  local padding=4 vm_type="" vm_name="" vm_ram="" vm_vcpus="" vm_disk="" vm_iso="" back="<-- Back"
  local ret=0 default_name="" option="" header="" answer="" choice="" mode="" height=0
  local menu=() iso_files=() menu=() options=() opts=() menu=() selected=() states=()
  [[ "$1" == "--one" ]] && { back=Quit ; shift ; }
  while : ; do
    case "$1" in
      list)
        vm list
        printf '\nPress Enter to continue'
        read -r
        return
        ;;
      start|stop|delete|reboot|reset|console)
        menu=() ; height=0 ; vms=() ; options=(--no-limit)
        states=(--state-shutoff --state-paused)
        [[ "$1" =~ ^stop|reboot|reset|console$ ]] && states=(--state-running --state-paused)
        [[ "$1" == console ]] && options=()
        [[ "$1" == delete ]] && states=(--all)
        mapfile -t menu < <(virsh --connect "${connect:-$CONNECT_URI}" list "${states[@]}" --name|grep .)
        if (( ${#menu[@]} == 0 )); then
          if [[ "$back" == Quit ]]; then
            echo "There are no VMs to ${1^}"
            exit
          fi
          return 2
        fi
        menu=("$back" "${menu[@]}")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        mapfile -t vms < <(gum filter "${GUM_STYLE[@]}" --placeholder="Choose VMs to ${1^}..." --header="${1^} VMs" --no-fuzzy-sort "${options[@]}" --height=$(( height + padding )) "${menu[@]}"; echo "ret=$?")
        ret=${vms[-1]##*=}
        case $ret in 130) exit ;; 0) ;; *) return 10 ;; esac
        vms=("${vms[@]:0:${#vms[@]}-1}")
        case "${vms[0]}" in
          "$back") return ;;
          '') echo "Error: Menu failure" >&2 ; exit 1 ;;
          *)
            # shellcheck disable=2086
            case "$1" in
              start|console) vm "$1" "${vms[@]}" ;;
              stop|reboot|restart|delete)
                answer=$(gum choose --header="Really ${1^} VMs: ${vms[*]}" Yes No)
                case $? in 130) exit ;; 0) ;; *) return 11 ;; esac
                [[ "$answer" == "Yes" ]] && vm "$1" --force "${vms[@]}"
                ;;
              *) return 100 ;;
            esac
            ;;
        esac
        ;;
      clone)
        selected=() ; menu=() ; summary=() ; options=() ; height=0 ; choice="" ; vm_name=""
        summary=("## Cloned VM Summary")
        mapfile -t menu < <(virsh --connect "${connect:-$CONNECT_URI}" list --all --name|grep .)
        (( ${#menu[@]} == 0 )) && return 2
        menu=("$back" "${menu[@]}")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        choice=$(gum filter "${GUM_STYLE[@]}" --placeholder="Choose a VM to ${1^}..." --header="${1^} a VM" --no-fuzzy-sort --height=$(( height + padding )) "${menu[@]}")
        (( "${#choice[@]}" == 0 )) && return 12
        case "$choice" in
          "$back") return ;;
          '') echo "Error: Menu failure" >&2 ; exit 1 ;;
          *) ;;
        esac
        vm_name=$(gum input "${GUM_STYLE[@]}" --placeholder="New VM Name" --header="Enter a name for the new VM...")
        case $? in 130) exit ;; 0) ;; *) return 5 ;; esac
        [[ -z "$vm_name" ]] && return 4
        summary+=("- Source VM: $choice")
        summary+=("- New VM: $vm_name")
        menu=("Start VM" "Connect to Console")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        mapfile -t options < <(gum filter "${GUM_STYLE[@]}" --no-limit --height=$(( height + padding )) --placeholder="Pick options for new $vm_name VM..." --no-fuzzy-sort --header="${1^} a VM" "${menu[@]}" ; echo "ret=$?")
        ret=${options[-1]##*=}
        case $ret in 130) exit ;; 0) ;; *) return 10 ;; esac
        (( ${#options[@]} > 1 )) && summary+=("- Options:")
        for option in "${options[@]}"; do
          case "$option" in
            "Start VM") opts+=(--start) ; summary+=("  - Start VM") ;;
            "Connect to Console") opts+=(--start-console) ; summary+=("  - Connect to Console") ;;
            *) ;;
          esac
        done
        summary+=("")
        summary+=("Clone '$choice' to '$vm_name'?")
        header=$(printf '%s\n' "${summary[@]}" | gum format)
        answer=$(gum choose --header="$header" Yes No)
        case $? in 130) exit ;; 0) ;; *) return 11 ;; esac
        [[ "$answer" == "Yes" ]] && vm clone "$choice" "$vm_name" "${opts[@]}"
        ;;
      snapshot)
        vms=() ; options=() ; choice="" ; mode="" ; vm_name="" ; answer=""
        menu=(
          "$back" "Create Snapshot" "List Snapshots"
          "List Snapshots (tree)" "Revert Snapshot" "Delete Snapshots"
        )
        height=${#menu[@]}
        (( height > 15 )) && height=15
        choice=$(gum filter "${GUM_STYLE[@]}" --placeholder="Choose an Snapshot action..." --header="VM Snapshot Management" --no-fuzzy-sort --height=$(( height + padding )) "${menu[@]}")
        case $? in 130) exit ;; 0) ;; *) return 13 ;; esac
        [[ "$choice" == "$back" ]] && return
        [[ "$choice" == "Create Snapshot" ]] && options=(--no-limit)
        mapfile -t menu < <(virsh --connect "${connect:-$CONNECT_URI}" list --all --name|grep .)
        if (( ${#menu[@]} == 0 )); then
          if [[ "$back" == Quit ]]; then
            echo "There are no VMs to ${1^}"
            exit
          fi
          return 2
        fi
        menu=("$back" "${menu[@]}")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        mapfile -t vms < <(gum filter "${GUM_STYLE[@]}" --placeholder="Choose VMs to ${1^}..." --header="VM Snapshot Management" --no-fuzzy-sort "${options[@]}" --height=$(( height + padding )) "${menu[@]}"; echo "$ret=$?")
        ret=${vms[-1]##*=}
        case $? in 130) exit ;; 0) ;; *) return 4 ;; esac
        vms=("${vms[@]:0:${#vms[@]}-1}")
        case "${vms[@]}" in
          "$back") return ;;
          '') echo "Error: Menu failure" >&2 ; exit 1 ;;
          *) ;;
        esac
        case "$choice" in
          "$back") return 2 ;;
          '') echo "Error: Menu failure" >&2 ; exit 1 ;;
          "Create Snapshot")
            snapshot=$(gum input "${GUM_STYLE[@]}" --placeholder="New ${1^} Name" --header="Enter a name for the new ${1^} for VMs...")
            case $? in 130) exit ;; 0) ;; *) return 14 ;; esac
            answer=$(gum input "${GUM_STYLE[@]}" --placeholder="New ${1^} Name" --header="Enter a description for the new ${1^} for VMs...")
            case $? in 130) exit ;; 0) ;; *) return 15 ;; esac
            options=()
            [[ -n "$answer" ]] && options=(--description "$answer")
            for vm_name in "${vms[@]}"; do
              vm snapshot "${options[@]}" "$vm_name" "$snapshot"
            done
            ;;
          "List Snapshots")
            vm snapshot --list "${vms[0]}"
            printf '\nPress Enter to continue'
            read -r
            ;;
          "List Snapshots (tree)")
            vm snapshot --list-tree "${vms[0]}"
            printf '\nPress Enter to continue'
            read -r
            ;;
          "Revert Snapshot"|"Delete Snapshots")
            mode=revert
            [[ "$choice" == "Delete Snapshots" ]] && mode=delete
            mapfile -t menu < <(virsh --connect "${connect:-$CONNECT_URI}" snapshot-list --name "${vms[0]}"|grep .)
            (( ${#menu[@]} == 0 )) && return 2
            menu=("$back" "${menu[@]}")
            height=${#menu[@]}
            (( height > 15 )) && height=15
            snapshot=$(gum filter "${GUM_STYLE[@]}" --placeholder="Choose a Snapshot to ${mode^}..." --header="VM Snapshot Management" --no-fuzzy-sort --height=$(( height + padding )) "${menu[@]}")
            case $? in 130) exit ;; 0) ;; *) return 4 ;; esac
            case "$snapshot" in
              "$back") return ;;
              '') echo "Error: Menu failure" >&2 ; exit 1 ;;
              *) ;;
            esac
            answer=$(gum choose --header="Really ${1^} $snapshot Snapshot for ${vms[0]}" Yes No)
            case $? in 130) exit ;; 0) ;; *) return 11 ;; esac
            [[ "$answer" == "Yes" ]] && vm "$1" --"$mode" --force --name "$snapshot" "${vms[0]}"
            ;;
          *) return 13 ;;
        esac
        ;;
      create)
        vm_type="" ; vm_name="" ; vm_ram="" ; vm_vcpus="" ; vm_disk="" ; vm_iso="" ; height=""
        ret=0 ; default_name="" ; option="" ; header="" ; answer=""
        menu=() ; options=() ; opts=() ; menu=()
        summary=("## VM Summary")
        (( ${#VM_TYPES[@]} == 0 )) && return 2
        menu=("$back" "${VM_TYPES[@]}")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        vm_type=$(gum filter "${GUM_STYLE[@]}" --placeholder="Choose a VM Type..." --header="${1^} a VM" --no-fuzzy-sort --height=$(( height + padding )) "${menu[@]}")
        (( $? == 130 )) && exit
        [[ -z "$vm_type" ]] && return 3
        default_name=${vm_type#*\(}
        default_name=${default_name%\)*}
        case "$vm_type" in
          "$back") return ;;
          '') echo "Error: Menu failure" >&2 ; exit 1 ;;
          *) ;;
        esac
        default_name=$(tr '[:upper:]' '[:lower:]' <<< "${default_name// /}")
        vm_name=$(gum input "${GUM_STYLE[@]}" --value="$default_name" --header="Enter a VM Name for $vm_type...")
        case $? in 130) exit ;; 0) ;; *) return 4 ;; esac
        summary+=("- Name: $vm_name")
        summary+=("- Type: $vm_type")
        vm_ram=$(gum input "${GUM_STYLE[@]}" --placeholder="Enter nothing to accept 8192" --header="Enter amount of RAM in MB for $vm_name...")
        case $? in 130) exit ;; 0) ;; *) return 5 ;; esac
        [[ "$vm_ram" =~ ^[0-9]+$ ]] && { opts+=(--disk "$vm_ram") ; summary+=("- RAM: $vm_ram MB$( (( vm_ram < 1024 )) && echo " * That's low" )") ; }
        vm_disk=$(gum input "${GUM_STYLE[@]}" --placeholder="Enter nothing to accept 20" --header="Enter disk size in GB for $vm_name...")
        case $? in 130) exit ;; 0) ;; *) return 7 ;; esac
        [[ "$vm_disk" =~ ^[0-9]+$ ]] && { opts+=(--disk "$vm_disk") ; summary+=("- Disk: $vm_disk$( (( vm_disk > 100 )) && echo " * That's high" )") ; }
        vm_vcpus=$(gum input "${GUM_STYLE[@]}" --placeholder="Enter nothing to accept 1" --header="Enter number of vCPUs for $vm_name...")
        case $? in 130) exit ;; 0) ;; *) return 6 ;; esac
        [[ "$vm_vcpus" =~ ^[0-9]+$ ]] && { opts+=(--cpus "$vm_vcpus") ; summary+=("- vCPUs: $vm_vcpus$( (( vm_vcpus > $(nproc) )) && echo " * That's high")") ; }
        (( ${#iso_files[@]} == 0 )) && mapfile -t iso_files < <(find "$ISO_PATH" -type f -name "*.iso" -printf "%f\n" 2>/dev/null|sort)
        (( ${#iso_files[@]} == 0 )) && return 8
        height=${#iso_files[@]}
        (( height > 15 )) && height=15
        vm_iso=$(gum filter "${GUM_STYLE[@]}" --height="$height" --placeholder="Pick an ISO file for $vm_name..." --no-fuzzy-sort --header="${1^} a VM" "${selected[@]}" "${iso_files[@]}")
        case $? in 130) exit ;; 0) ;; *) return 9 ;; esac
        [[ -r "$vm_iso" ]] && { opts+=(--iso "$vm_iso") ; summary+=("- vCPUs: $vm_vcpus") ; }
        menu=("Disable GPU" "Enable TPM Emulation" "Test Mode (just print command)")
        height=${#menu[@]}
        (( height > 15 )) && height=15
        mapfile -t options < <(gum filter "${GUM_STYLE[@]}" --no-limit --height=$(( height + padding )) --placeholder="Pick options for $vm_name..." --no-fuzzy-sort --header="${1^} a VM" "${menu[@]}" ; echo "ret=$?")
        ret=${options[-1]##*=}
        case $ret in 130) exit ;; 0) ;; *) return 10 ;; esac
        (( ${#options[@]} > 1 )) && summary+=("- Options:")
        for option in "${options[@]}"; do
          case "$option" in
            "Start VM") opts+=(--start) ; summary+=("  - Start VM") ;;
            "Connect to Console") opts+=(--start-console) ; summary+=("  - Connect to Console") ;;
            "Disable GPU") opts+=(--disable-gpu) ; summary+=("  - Disable GPU") ;;
            "Enable TPM Emulation") opts+=(--emulated-tpm) ; summary+=("  - Emulated TPM") ;;
            "Test Mode (just print command)") opts+=(--test) ; summary+=("  - Test Mode") ;;
            *) ;;
          esac
        done
        summary+=("")
        summary+=("Build new VM?")
        header=$(printf '%s\n' "${summary[@]}" | gum format)
        answer=$(gum choose --header="$header" Yes No)
        case $? in 130) exit ;; 0) ;; *) return 11 ;; esac
        [[ "$answer" == "Yes" ]] && vm create --"$default_name" "${opts[@]}"
        ;;
      *) return 100 ;;
    esac
  done
}

main_menu() {
  if ! command -v gum &>/dev/null; then
    echo "Gum not found: Cannot load interactive menus" >&2
    main_usage 1
  fi

  local choice header padding=5 height=0 ret=0
  case "$1" in
      start)    sub_menu --one start    ; exit ;;
      stop)     sub_menu --one stop     ; exit ;;
      reboot)   sub_menu --one reboot   ; exit ;;
      reset)    sub_menu --one reset    ; exit ;;
      console)  sub_menu --one console  ; exit ;;
      create)   sub_menu --one create   ; exit ;;
      clone)    sub_menu --one clone    ; exit ;;
      delete)   sub_menu --one delete   ; exit ;;
      list)     sub_menu --one list     ; exit ;;
      snapshot) sub_menu --one snapshot ; exit ;;
      quit)     exit ;;
      *)        ;;
  esac
  while : ; do
    case "${ret:-0}" in
      2) header="$(gum style --foreground=212 "$choice")$(gum style --foreground=33 " has no VMs available")" ;;
      3) header="Invalid VM Type given for $(gum style --foreground=212 "$choice")" ;;
      4) header="Invalid VM Name given for $(gum style --foreground=212 "$choice")" ;;
      5) header="Invalid VM RAM given for $(gum style --foreground=212 "$choice")" ;;
      6) header="Invalid VM vCPUs given for $(gum style --foreground=212 "$choice")" ;;
      7) header="Invalid VM Disk given for $(gum style --foreground=212 "$choice")" ;;
      8) header="No ISO files found for $(gum style --foreground=212 "$choice")" ;;
      9) header="Invalid VM ISO given for $(gum style --foreground=212 "$choice")" ;;
      10) header="Invalid options given for $(gum style --foreground=212 "$choice")" ;;
      11) header="Invalid confirmation to build given for $(gum style --foreground=212 "$choice")" ;;
      12) header="Invalid source VM for $(gum style --foreground=212 "$choice")" ;;
      13) header="Invalid action for $(gum style --foreground=212 "$choice")" ;;
      14) header="Invalid name for $(gum style --foreground=212 "$choice")" ;;
      15) header="Invalid description for $(gum style --foreground=212 "$choice")" ;;
      100) header="$(gum style --foreground=212 "$choice")$(gum style --foreground=33 " not implemented")" ;;
      *) header="" ; (( padding-- )) ;;
    esac
    height=${#MAIN_MENU[@]}
    [[ -z "$header" ]] && header="VM Management"
    [[ -n "$header" ]] && (( height++ ))
    (( height > 15 )) && height=15
    choice=$(gum filter "${GUM_STYLE[@]}" --placeholder="Choose an action..." --header="$header" --no-fuzzy-sort --height=$(( height + padding )) "${MAIN_MENU[@]}")
    (( $? == 130 )) && exit
    ret=0
    case $choice in
      "Start VM(s)")  sub_menu start    ; ret=$? ;;
      "Stop VM(s)")   sub_menu stop     ; ret=$? ;;
      "Reboot VM(s)") sub_menu reboot   ; ret=$? ;;
      "Reset VM(s)")  sub_menu reset    ; ret=$? ;;
      "VM Console")   sub_menu console  ; ret=$? ;;
      "Create VM")    sub_menu create   ; ret=$? ;;
      "Clone VM")     sub_menu clone    ; ret=$? ;;
      "Delete VM(s)") sub_menu delete   ; ret=$? ;;
      "List VMs")     sub_menu list     ; ret=$? ;;
      "VM Snapshots") sub_menu snapshot ; ret=$? ;;
      "Quit")         exit ;;
      *)              ;;
    esac
    (( ${#MAIN_MENU[@]} > 0 )) && [[ "${MAIN_MENU[0]}" != "Quit" ]] &&
      MAIN_MENU=("${MAIN_MENU[-1]}" "${MAIN_MENU[@]:0:${#MAIN_MENU[@]}-1}")
  done
}

main_usage() {
  echo "usage: ${0##*/} MODE"
  echo
  echo "MODE can be:"
  echo "  clone    = Create clone of VM  : ${0##*/} clone [-h] [-u|-c URI] [-s|-S] SRC_VM DEST_VM"
  echo "  create   = Create a new VM     : ${0##*/} create [-h] [-A|-D|-F|-G|-O|-Q] [-n NAME] [-r RAM] [-v CPU] [-d DISKSZ] [-i ISO] [-g] [-T]"
  echo "  delete   = Delete/Destroy VM   : ${0##*/} delete [-h] [-f] VM_TO_DELETE"
  echo "  list     = List VMs            : ${0##*/} list [-h] [-a] [-A] [-r] [-o] [-p] [-s] [-S] [-i] NETWORK]"
  echo "  reboot   = Reboot guest        : ${0##*/} reboot [-h]"
  echo "  reset    = Forceably reset VM  : ${0##*/} reset [-h]"
  echo "  snapshot = Manage VM snapshots : ${0##*/} snapshot [-h] [-f] [-n SNAPSHOT_NAME] [-d DESC] [-l] [-t] [-D] [-R] VM_NAME.."
  echo "  start    = Start VM            : ${0##*/} start [-h] [-c] VM_NAME"
  echo "  stop     = Stop VM             : ${0##*/} stop [-h] [-f] VM_NAME"
  echo "  help     = This help"
  exit "${1:-0}"
}

main() {
  local action=$1
  [[ -z "$action" ]] && { main_menu "$@" ; exit ; }

  case "$action" in
    "Clone VM"|clone|copy|duplicate|dupe) shift ; clone "$@" ;;
    "Create VM"|create|install|new) shift ; create "$@" ;;
    "Delete VM(s)"|delete|del|remove|rm) shift ; delete "$@" ;;
    "List VMs") shift ; list --gui "$@" ;;
    list|ls) shift ; list "$@" ;;
    "Reboot VM(s)"|reboot) shift ; reboot "$@" ;;
    "Reset VM(s)"|reset) shift ; reboot --reset "$@" ;;
    "VM Snapshots"|snapshot|snap) shift ; snapshot "$@" ;;
    "Start VM(s)"|start) shift ; start "$@" ;;
    "Stop VM(s)"|stop|shutdown|destroy) shift ; start --stop "$@" ;;
    "Join Console"|console) shift ; start --join-console "$@" ;;
    "Quit") exit ;;
    ''|help|--help|-h)
      shift
      case "$1" in
        clone|copy|duplicate|dupe) clone -h ;;
        create|new) create -h ;;
        delete|del|remove|rm) delete -h ;;
        list|ls) list -h ;;
        reboot) reboot -h ;;
        reset) reboot --reset -h ;;
        console) start --join-console -h ;;
        snapshot|snap) snapshot -h ;;
        start) start -h ;;
        stop|shutdown|destroy) start --stop -h ;;
        *) main_usage ;;
      esac
      ;;
    -*) create "$@" ;;
    *) echo "Error: Invalid command" >&2 ; main_usage 1
  esac
}

# Do not run main if sourced from another script
if (return 2> /dev/null); then
  return 0
else
  main "$@"
fi

