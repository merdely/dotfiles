  done

  (( $# == 0 )) && reset_usage 1

  virsh "${connect[@]}" reset "$1"
}

snapshot_usage() {
  echo "usage: ${0##*/} snapshot [Options] VM_NAME [SNAPSHOT_NAME]"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Force delete with -D"
  echo "  -d|--description DESCR : Snapshot description (default: none)"
  echo "  -l|--list           : List snapshots for VM_NAME"
  echo "  -t|--list-tree      : List snapshots for VM_NAME (tree)"
  echo "  -D|--delete         : Delete SNAPSHOT_NAME snapshot for VM_NAME"
  echo "  -R|--revert         : Revert/restore VM_NAME to SNAPSHOT_NAME"
  exit "${1:-0}"
}

snapshot() {
  local mode=create vm="" snapshot="snapshot1" description="" force=false REPLY=""
  local desc=() disks=() disk_opt=() disk="" mem_opt=()
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:fd:ltDR"
  local OPT_LONG=(
    "help" "user" "session" "connect:" "force" "description:" "list" "list-tree" "delete" "revert"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) snapshot_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -d|--description) shift ; description=$1 ;;
      -f|--force) force=true ;;
      -l|--list) mode=list ;;
      -t|--list-tree) mode=list-tree ;;
      -D|--delete) mode=delete ;;
      -R|--revert) mode=revert ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && snapshot_usage 1
  vm=$1
  shift

  if [[ "$mode" == list ]]; then
    virsh "${connect[@]}" snapshot-list "$vm"
    return
  elif [[ "$mode" == list-tree ]]; then
    virsh "${connect[@]}" snapshot-list "$vm" --tree
    return
  fi

  if [[ "$mode" == delete ]]; then
    if [[ -z "$1" ]]; then
      echo "Error: SNAPSHOT_NAME must be provided with -D" >&2
      exit 1
    fi
    if ! "$force"; then
      read -rp "Really delete snapshot '$1' for $vm? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not deleting '$1' for $vm"
        exit
      fi
      echo
    fi
    virsh "${connect[@]}" snapshot-delete "$vm" "$1"
    return
  fi

  if [[ "$mode" == revert ]]; then
    if [[ -z "$1" ]]; then
      echo "Error: SNAPSHOT_NAME must be provided with -R" >&2
      exit 1
    fi
    if ! "$force"; then
      read -rp "Really revert $vm to snapshot '$1'? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not reverting $vm to '$1'"
        exit
      fi
      echo
    fi
    virsh "${connect[@]}" snapshot-revert "$vm" "$1"
    return
  fi

  snapshot="$1"

  mapfile -t disks < <(virsh "${connect[@]}" domblklist "$vm" --details | awk '$1=="file" && $2=="disk" {print $3}')

  for disk in "${disks[@]}"; do
    disk_opt+=(--diskspec "$disk,snapshot=external")
  done
  if (( ${#disk_opt[@]} == 0 )); then
    echo "Error: Could not determine disks for $vm" >&2
    exit 1
  fi

  if [[ -n "$description" ]]; then
    desc=(--description "$description")
  fi

  # shellcheck disable=SC2174
  [[ ! -d /var/lib/libvirt/qemu/snapshot/"$vm" ]] &&
    mkdir -m 775 -p /var/lib/libvirt/qemu/snapshot/"$vm"

  if ! grep -q "shut off" < <(virsh "${connect[@]}" domstate "$vm"); then
    mem_opt=(--memspec "/var/lib/libvirt/qemu/snapshot/$vm/$snapshot-memory,snapshot=external")
  fi

  virsh "${connect[@]}" snapshot-create-as "$vm" --name "$snapshot" "${desc[@]}" \
    --atomic "${disk_opt[@]}" "${mem_opt[@]}"
}

start_usage() {
  echo "usage: ${0##*/} start [Options] VM_NAME"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -C|--console        : Start and attach to console"
  exit "${1:-0}"
}

start() {
  local opts=()
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:C"
  local OPT_LONG=("help" "user" "session" "connect:" "console")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) start_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -C|--console) opts+=(--console) ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && start_usage 1

  virsh "${connect[@]}" start "$1" "${opts[@]}"
}

stop_usage() {
  echo "usage: ${0##*/} stop [Options] VM_NAME"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Force shutdown (destroy)"
  exit "${1:-0}"
}

stop() {
  local force=false
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:"
  local OPT_LONG=("help" "user" "session" "connect:")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) stop_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# == 0 )) && stop_usage 1

  if $force; then
    virsh "${connect[@]}" destroy "$1"
  else
    virsh "${connect[@]}" shutdown "$1"
  fi
}

get_os_variant() {
  command -v virt-install &>/dev/null || { echo "Error: virt-install is required for this program" >&2 ; exit 1 ; }

  (( $# < 1 )) && { echo "usage: get_os_variant SEARCHSTRING" ; return 1 ; }
  virt-install --osinfo list | \
    awk -F, -v os="$1" '$0 ~ "^" os "([[:digit:]]|$)" { print $1 }' | \
    sort -V | \
    tail -n1
}

get_iso() {
  (( $# < 1 )) && { echo "usage: get_iso ISOSEARCH [VM_ISO]" ; return 1 ; }
  local iso_search=$1 vm_iso=$2 ng=false
  if [[ -z "$vm_iso" ]]; then
    shopt -q ng && ng=true ; shopt -u nullglob
    for iso in "$iso_path"/$iso_search; do
      vm_iso=$(printf "%s\n%s\n" "$vm_iso" "$iso" | grep . | sort -V | tail -n1)
    done
    $ng && shopt -s nullglob ; ng=false
  fi
  [[ -z "$vm_iso"   ]] && { echo "Error: ISO not defined" ; exit 1 ; }
  [[ ! -r "$vm_iso" ]] && { echo "Error: ISO not found"   ; exit 1 ; }
  echo "$vm_iso"
}

main_usage() {
  echo "usage: ${0##*/} MODE"
  echo
  echo "MODE can be:"
  echo "  clone    = Create clone of VM  : ${0##*/} clone [-h] [-u|-c URI] [-s|-S] SRC_VM DEST_VM"
  echo "  create   = Create a new VM     : ${0##*/} create [-h] [-A|-D|-F|-G|-O|-Q] [-n NAME] [-r RAM] [-v CPU] [-d DISKSZ] [-i ISO] [-g] [-T]"
  echo "  delete   = Delete/Destroy VM   : ${0##*/} delete [-h] [-f] VM_TO_DELETE"
  echo "  list     = List VMs            : ${0##*/} list [-h] [-a] [-A] [-r] [-o] [-p] [-s] [-S] [-i] NETWORK]"
  echo "  reboot   = Reboot guest        : ${0##*/} reboot [-h]"
  echo "  reset    = Forceably reset VM  : ${0##*/} reset [-h]"
  echo "  snapshot = Manage VM snapshots : ${0##*/} snapshot [-h] [-f] [-d DESC] [-l] [-t] [-D] [-R] VM_NAME [SNAPSHOT_NAME]"
  echo "  start    = Start VM            : ${0##*/} start [-h] [-c] VM_NAME"
  echo "  stop     = Stop VM             : ${0##*/} stop [-h] [-f] VM_NAME"
  echo "  help     = This help"
  exit "${1:-0}"
}

main() {
  command -v virsh &>/dev/null || { echo "Error: virsh is required for this program" >&2 ; exit 1 ; }

  case "$1" in
    clone|copy|duplicate|dupe) shift ; clone "$@" ;;
    create|new) shift ; create "$@" ;;
    delete|del|remove|rm) shift ; delete "$@" ;;
    list|ls) shift ; list "$@" ;;
    reboot) shift ; reboot "$@" ;;
    reset) shift ; reset "$@" ;;
    snapshot|snap) shift ; snapshot "$@" ;;
    start) shift ; start "$@" ;;
    stop|shutdown|destroy) shift ; stop "$@" ;;
    ''|help|--help|-h)
      shift
      case "$1" in
        clone|copy|duplicate|dupe) clone -h ;;
        create|new) create -h ;;
        delete|del|remove|rm) delete -h ;;
        list|ls) list -h ;;
        reboot) reboot -h ;;
        reset) reset -h ;;
        snapshot|snap) snapshot -h ;;
        start) start -h ;;
        stop|shutdown|destroy) stop -h ;;
        *) main_usage ;;
      esac
      ;;
    -*) create "$@" ;;
    *) echo "Error: Invalid command" >&2 ; main_usage 1
  esac
}

main "$@"

