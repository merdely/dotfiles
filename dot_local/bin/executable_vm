#!/usr/bin/env bash
# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.local/bin/vm
# Or after editing, run: chezmoi re-add ~/.local/bin/vm

CONNECT_URI="qemu:///system"
ISO_PATH=/share/software/Isos
# _LIB="/../lib"            # comment this line out if parseopts.sh is in the same directory as $0
# _LIBDIR=/srv/scripts/lib  # Use a line like this to override location of parseopts.sh
PARSEOPTS="${_LIBDIR:-"$(dirname "$0")${_LIB:-}"}/parseopts.sh"
# shellcheck disable=SC1090,SC1091
source "$PARSEOPTS" ; unset _LIB _LIBDIR

gumcheck() {
  local usage=${1:-usage}
  if ! command -v gum &>/dev/null; then
    echo "Gum not found: Cannot load interactive menus" >&2
    "$usage" "$2"
    return 1
  fi
  return 0
}

clone_usage() {
  echo "usage: ${0##*/} clone [Options] SRC_VM DEST_VM"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -s|--start          : Start new VM after clone"
  echo "  -S|--start-console  : Start new VM after clone and connect to the console"
  exit "${1:-0}"
}

clone() {
  command -v virt-clone &>/dev/null || { echo "Error: virt-clone is required for this program" >&2 ; exit 1 ; }

  local src_vm=$1 dest_vm=$2
  local connect=(--connect "$CONNECT_URI") start=false opts=()
  local OPT_SHORT="huc:sS"
  local OPT_LONG=("help" "user" "session" "connect:" "start" "start-console")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET

  while true; do
    case $1 in
      -h|--help) clone_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -s|--start) start=true ;;
      -S|--start-console) start=true ; [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  if [[ -z "$src_vm" || -z "$dest_vm" ]]; then
    gumcheck clone_usage
    local selected=() vms=()
    mapfile -t vms < <(virsh "${connect[@]}" list --all | awk 'NR>2&&/./{print $2}' 2> /dev/null | sort -n)
    vms+=("<-- Back")
    local height=$(( ${#vms[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    [[ -n "$src_vm" ]] && selected=(--selected="$src_vm")
    if ! src_vm=$(gum filter --no-fuzzy-sort --height=$height --placeholder="Select VM to Clone> " "${selected[@]}" "${vms[@]}"); then
      echo "Error getting source VM" >&2
      exit 1
    fi
    [[ -z "$src_vm" || "$src_vm" == "<-- Back" ]] && return
    local value=()
    [[ -n "$dest_vm" ]] && value=(--value="$dest_vm")
    if ! dest_vm=$(gum input --header="Enter Name for New VM> " "${value[@]}"); then
      echo "Error getting destination VM name" >&2
      exit 1
    fi
    [[ -z "$dest_vm" ]] && return
    local output=() item="" tmp=""
    if tmp=$(gum filter --height=5 --header="Start VM? " --selected "Start VM" --no-limit "Start VM" "Connect to Console"); then
      mapfile -t output <<< "$tmp"
      start=false
      for item in "${output[@]}"; do
        case "$item" in
          "Start VM") start=true ;;
          "Connect to Console") [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
        esac
      done
    else
      return
    fi
  fi

  virt-clone "${connect[@]}" --auto-clone --original "$src_vm" --name "$dest_vm"
  $start && virsh "${connect[@]}" start "$dest_vm" "${opts[@]}" || true
}

create_usage() {
  echo "usage: ${0##*/} create [Options]"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -n|--name NAME      : Name for the VM (default: ${1:-vm_type})"
  echo "  -r|--name SIZE      : RAM SIZE in MB (default: $vm_ram MB)"
  echo "  -v|--cpus COUNT     : VCPU COUNT (default $vm_vcpus)"
  echo "  -d|--disk SIZE      : Disk SIZE in GB (default: $vm_disk GB)"
  echo "  -i|--iso ISO        : ISO path (default: latest iso in $ISO_PATH for vm_type)"
  echo "  -g|--disable-gpu    : Disable GPU mode"
  echo "  -t|--emulated-tpm   : Add emulated TPM module"
  echo "  -T|--test           : Test mode (print command instead of running it)"
  echo "  -s|--start          : Start VM after creation"
  echo "  -S|--start-console  : Start VM after creation and connect to the console"
  echo
  echo "VM Type Options:"
  echo "  -A|--arch           : Arch Linux"
  echo "  -D|--debian         : Debian"
  echo "  -F|--fedora         : Fedora Workstation"
  echo "  -G|--fedora-server  : Fedora Server"
  echo "  -K|--fedora-kde     : Fedora KDE Desktop"
  echo "  -O|--openbsd        : OpenBSD"
  echo "  -Q|--ol9            : Oracle Enterprise Linux 9"
  echo
  echo "One VM Type Option is required"
  exit "${1:-0}"
}
create() {
  command -v virt-install &>/dev/null || { echo "Error: virt-install is required for this program" >&2 ; exit 1 ; }

  local vm_name=$1 vm_ram=8192 vm_vcpus=2 vm_disk=20 vm_iso=""

  # shellcheck disable=1091
  [[ -r "$HOME"/.config/newvmrc ]] && source "$HOME"/.config/newvmrc

  local testmode="" vm_type="" tpm_mode=()
  local gpu_mode=(
    "--graphics" "spice,listen=none"
    "--graphics" "egl-headless,gl.rendernode=/dev/dri/by-path/pci-0000:00:02.0-render"
    "--video" "model=virtio,accel3d=yes"
  )

  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="hcu:ADOQn:r:v:d:i:gtTsS"
  local OPT_LONG=("help" "user" "session" "connect:" "name:" "ram:" "cpus:"
    "disk:" "iso:" "disable-gpu" "tpm" "emulated-tpm" "test" "start" "start-console"
    "arch" "archlinux" "debian" "fedora" "fedora-server" "fedora-kde"
    "openbsd" "ol9" "oraclelinux9"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) create_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -n|--name) shift ; vm_name=$1 ;;
      -r|--ram)  shift ; vm_ram=$1 ;;
      -v|--cpus) shift ; vm_vcpus=$1 ;;
      -d|--disk) shift ; vm_disk=$1 ;;
      -i|--iso)  shift ; vm_iso=$1 ; ;;
      -g|--disable-gpu) gpu_mode=("--video" "virtio") ;;
      -t|--tpm|--emulated-tpm) tpm_mode=(--tpm "backend.type=emulator,backend.version=2.0,backend.profile.source=default-v1,model=tpm-crb") ;;
      -T|--test) testmode="echo" ;;
      -s|--start) start=true ;;
      -S|--start-console) start=true ; [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
      -A|--arch|--archlinux) vm_type=arch ;;
      -D|--debian) vm_type=debian ;;
      -F|--fedora) vm_type=fedora ;;
      -G|--fedora-server) vm_type=fedora-server ;;
      -K|--fedora-kde) vm_type=fedora-kde ;;
      -O|--openbsd) vm_type=openbsd ;;
      -Q|--ol9|--oraclelinux9) vm_type=ol9 ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  if [[ -z "$vm_type" ]]; then
    gumcheck create_usage
    local vm_types=(
      "Arch Linux" Debian "Fedora Workstation" "Fedora Server" "Fedora KDE Desktop"
      "OpenBSD" "Oracle Enterprise Linux 9" "<-- Back"
    )
    local height=$(( ${#vm_types[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    if ! vm_type=$(gum filter --height=$height --placeholder="Choose VM Type> " "${vm_types[@]}"); then
      echo "Error getting VM Type" >&2
      exit 1
    fi
    [[ -z "$vm_type" || "$vm_type" == "<-- Back" ]] && return

    local value=()
    [[ -n "$vm_type" ]] && value=(--value="$(tr '[[:upper:]]' '[[:lower:]]' <<< ${vm_type// /})")
    if ! vm_name=$(gum input --header="VM Name for $vm_type? " "${value[@]}"); then
      echo "Error getting VM Name" >&2
      exit 1
    fi

    local value=()
    [[ -n "$vm_ram" ]] && value=(--value="$vm_ram")
    if ! vm_ram=$(gum input --header="How much RAM for $vm_type? " "${value[@]}"); then
      echo "Error getting RAM" >&2
      exit 1
    fi

    value=() ; [[ -n "$vm_vcpus" ]] && value=(--value="$vm_vcpus")
    if ! vm_vcpus=$(gum input --header="How many virtual CPUs for $vm_type? " "${value[@]}"); then
      echo "Error getting vCPUs" >&2
      exit 1
    fi

    value=() ; [[ -n "$vm_disk" ]] && value=(--value="$vm_disk")
    if ! vm_disk=$(gum input --header="How much disk space for $vm_type? " "${value[@]}"); then
      echo "Error getting disks space" >&2
      exit 1
    fi

    local iso_files=()
    value=() ; [[ -n "$vm_iso" ]] && value=(--selected="$vm_iso")
    mapfile -t iso_files < <(find "$ISO_PATH" -type f -iname "*.iso" -printf "%f\n" | sort)
    (( ${#iso_files[@]} == 0 )) && { echo "Error: Could not find any ISO files in $ISO_PATH" >&2 ; exit 1 ; }
    local height=$(( ${#iso_files[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    vm_iso=$(gum filter --height=$height --placeholder="Pick an ISO to use for $vm_type? " "${value[@]}" "${iso_files[@]}")
    (( $? == 130 )) && return
    [[ -n "$vm_iso" && "$vm_iso" != "nothing selected" ]] && vm_iso="$ISO_PATH"/"${vm_iso#"$ISO_PATH"/}"

    local output=() item="" tmp="" options=()
    options=("Start VM" "Connect to Console" "Disable GPU" "Test Mode (just print)")
    options=("Disable GPU" "Emulated TPM" "Test Mode (just print)")
    value=(--selected="Start VM,Connect to Console")
    local height=$(( ${#options[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    mapfile -t output < <(gum filter --height=$height --no-limit --header="VM Options> " "${value[@]}" --no-limit "${options[@]}")
    for item in "${output[@]}"; do
      case "$item" in
        "Start VM") start=true ;;
        "Connect to Console") [[ " ${opts[*]} " != *" --console "* ]] && opts+=(--console) ;;
        "Disable GPU") gpu_mode=("--video" "virtio") ;;
        "Emulated TPM") tpm_mode=(--tpm "backend.type=emulator,backend.version=2.0,backend.profile.source=default-v1,model=tpm-crb") ;;
        "Test Mode (just print)") testmode="echo" ;;
        *) ;;
      esac
    done
  fi

  # Get system information
  local sys_ram="" sys_proc="" sys_disk=""
  sys_ram=$(free -m | awk '/^Mem:/{print $2}')
  if [[ ! "$sys_ram" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system RAM"
    exit 1
  fi
  if command -v nproc &> /dev/null; then
    sys_proc=$(nproc)
  elif [[ -r /proc/cpuinfo ]]; then
    sys_proc=$(grep -Ec "^processor[[:space:]]*:")
  fi
  if [[ ! "$sys_proc" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system cpu count"
    exit 1
  fi
  sys_disk=$(df -k --output=avail /var/lib/libvirt/images | tail -n1)
  if [[ ! "$sys_disk" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Could not determine system disk availability"
    exit 1
  fi

  # Validate RAM
  if [[ ! "$vm_ram" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: RAM must be numeric ($vm_ram)"
    exit 1
  elif (( vm_ram > sys_ram - 5 )); then
    echo "Error: Not enough system RAM for $vm_ram MB ($sys_ram MB on system)"
    exit 1
  elif (( vm_ram > sys_ram * 2 / 3 )); then
    echo "Warning: Using more than 2/3 system ram ($vm_ram of $sys_ram MB)"
  fi

  # Validate CPU count
  if [[ ! "$vm_vcpus" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: VCPU count must be numeric ($vm_vcpus)"
    exit 1
  elif (( vm_vcpus > sys_proc )); then
    echo "Error: VCPU count greater than system cpu count ($vm_vcpus > $sys_proc)"
    exit 1
  fi

  # Validate Disk size
  if [[ ! "$vm_disk" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Disk size must be numeric ($vm_disk)"
    exit 1
  elif (( vm_disk > sys_disk - 20 )); then
    echo "Error: Disk size of $vm_disk GB uses too much of $sys_disk GB available"
    exit 1
  fi

  # Validate ISO directory
  local iso_found=false iso=""
  for iso in "$ISO_PATH"/*.iso; do
    iso_found=true
    break
  done
  [[ ! -d "$ISO_PATH" ]] && { echo "Error: Could not find $ISO_PATH" ; exit 1 ; }
  if ! $iso_found; then
    echo "Error: Could not find any ISO files in $ISO_PATH"
    exit 1
  fi

  local os_variant="" vm_label="" os_search="" iso_search="" install_flags=()
  case "$vm_type" in
    "Arch Linux"|arch)
      vm_label="Arch Linux"
      os_search=archlinux
      iso_search="archlinux-*.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=arch/boot/x86_64/vmlinuz-linux,initrd=arch/boot/x86_64/initramfs-linux.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "archisodevice=/dev/sr0"
      )
      ;;
    Debian|debian)
      vm_label=Debian
      os_search=debian
      iso_search="debian-*-netinst.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso"
        "--extra-args" "console=ttyS0,115200n8 --- console=ttyS0,115200n8"
      )
      ;;
    "Fedora Workstation"|"Fedora KDE Desktop"|"Fedora Server"|fedora|fedora-kde|fedora-server)
      case "$vm_type" in
        "Fedora Workstation"|fedora)
          vm_label="Fedora Workstation"
          os_search='fedora'
          iso_search="Fedora-Workstation*-x86_64*.iso"
          ;;
        "Fedora KDE Desktop"|fedora-kde)
          vm_label="Fedora KDE Desktop"
          os_search='fedora'
          iso_search="Fedora-KDE-Desktop*-x86_64*.iso"
          ;;
        "Fedora Server"|fedora-server)
          vm_label="Fedora Server"
          os_search='fedora'
          iso_search="Fedora-Server*-x86_64*.iso"
          ;;
        *) echo "Error: Invalid Fedora Selection" ; exit 1
      esac
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=images/pxeboot/vmlinuz,initrd=images/pxeboot/initrd.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "inst.text"
      )
      ;;
    OpenBSD|openbsd)
      vm_label=OpenBSD
      os_search=openbsd
      iso_search="openbsd-install*-serial.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=( "--cdrom" "$vm_iso" )
      ;;
    "Oracle Enterprise Linux 9"|ol9)
      vm_label="Oracle Enterprise Linux"
      os_search='ol9\\.'
      iso_search="OracleLinux-R9-U*-x86_64-boot-uek.iso"
      [[ -z "$vm_iso" ]] && vm_iso=$(get_iso "$iso_search" "$vm_iso")
      install_flags=(
        "--location" "$vm_iso,kernel=images/pxeboot/vmlinuz,initrd=images/pxeboot/initrd.img"
        "--extra-args" "console=ttyS0,115200"
        "--extra-args" "inst.text"
      )
      ;;
    *)
      echo "Error: Invalid VM Type" >&2
      exit 1
      ;;
  esac

  os_variant=$(get_os_variant "$os_search")
  echo "Installing a new $vm_label VM: name=$vm_name, ram=$vm_ram, disk=$vm_disk, cpu=$vm_vcpus"

  $testmode virt-install "${connect[@]}" \
    --os-variant "$os_variant" --name "$vm_name" --ram "$vm_ram" --vcpus "$vm_vcpus" \
    --disk path=/var/lib/libvirt/images/"$vm_name".qcow2,size="$vm_disk",format=qcow2 \
    --vsock cid.auto=yes --boot uefi "${gpu_mode[@]}" "${tpm_mode[@]}" --autoconsole text \
    "${install_flags[@]}"
}

delete_usage() {
  echo "usage: ${0##*/} delete [Options] VM_TO_DELETE.."
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Do not prompt for confirmation"
  exit "${1:-0}"
}

delete() {
  local force=false pronoun=its vmlabel=VM vm="" REPLY=""
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:f"
  local OPT_LONG=("help" "user" "session" "connect:" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) delete_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  (( $# > 1 )) && { pronoun=their ; vmlabel=VMs ; }

  if (( $# == 0 )); then
    gumcheck delete_usage
    local vms=() tmp=""
    mapfile -t vms < <(virsh "${connect[@]}" list --all | awk 'NR>2&&/./{print $2}' 2> /dev/null | sort -n)
    vms+=("<-- Back")
    local height=$(( ${#vms[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    mapfile -t vms < <(gum filter --height=$height --no-limit --header="Select VMs to Delete> " "${vms[@]}")
    if (( ${#vms[@]} == 0 )); then
      echo "Error getting VM to Delete" >&2
      exit 1
    fi
    for tmp in "${vms[@]}"; do
      [[ "$tmp" == "<-- Back" ]] && return
    done
    set -- "${vms[@]}"
    (( $# > 1 )) && { pronoun=their ; vmlabel=VMs ; }

    if ! "$force"; then
      tmp=$(gum choose --header="Really delete $vmlabel ($*) and $pronoun storage? " No Yes)
      if [[ "$tmp" != "Yes" ]]; then
        echo "Not deleting $vmlabel: $*"
        return
      fi
    fi
  else
    if ! "$force"; then
      read -rp "Really delete $vmlabel ($*) and $pronoun storage? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not deleting $vmlabel: $*"
        exit
      fi
      echo
    fi
  fi

  for vm in "$@"; do
    if ! grep -q "shut off" < <(virsh "${connect[@]}" domstate "$vm"); then
      virsh "${connect[@]}" destroy "$vm"
    fi
    virsh "${connect[@]}" undefine "$vm" --nvram --remove-all-storage
  done
}

list_usage() {
  echo "usage: ${0##*/} list [Options]"
  echo
  echo "Options:"
  echo "  -h|--help             : This help text"
  echo "  -u|--user|--session   : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI      : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -a|--all              : Print all VMs (default action)"
  echo "  -A|--autostart        : Print VMs set to autostart"
  echo "  -r|--running          : Print running VMs"
  echo "  -o|--stopped          : Print off/stopped VMs"
  echo "  -p|--paused           : Print paused VMs"
  echo "  -s|--with-snapshot    : Print VMs with snapshot"
  echo "  -S|--without-snapshot : Print VMs without snapshot"
  echo "  -i|--list-ips         : List DHCP IP Address List"
  echo "                          Pass a network name on the command line (default: 'default')"
  exit "${1:-0}"
}

list() {
  local opts=() mode=list
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:aAropsSi"
  local OPT_LONG=(
    "help" "user" "session" "connect:" "all" "autostart" "running" "on"
    "off" "shutoff" "stopped" "paused" "with-snapshot" "without-snapshot" "list-ips"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) list_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -a|--all) [[ " ${opts[*]} " != *" --all "* ]] && opts+=(--all) ;;
      -A|--autostart) [[ " ${opts[*]} " != *" --autostart "* ]] && opts+=(--autostart) ;;
      -r|--on|--running) [[ " ${opts[*]} " != *" --state-running "* ]] && opts+=(--state-running) ;;
      -o|--off|--stopped|--shutoff) [[ " ${opts[*]} " != *" --state-shutoff "* ]] && opts+=(--state-shutoff) ;;
      -p|--paused) [[ " ${opts[*]} " != *" --state-paused "* ]] && opts+=(--state-paused) ;;
      -s|--with-snapshot) [[ " ${opts[*]} " != *" --with-snapshot "* ]] && opts+=(--with-snapshot) ;;
      -S|--without-snapshot) [[ " ${opts[*]} " != *" --without-snapshot "* ]] && opts+=(--without-snapshot) ;;
      -i|--list-ips) mode=ip ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  if (( ${#opts[@]} == 0 )) && [[ "$mode" == list ]]; then
    gumcheck list_usage
    local options=(
      "All VMs" "Autostart VMs" "Running VMs" "Stopped VMs" "Paused VMs"
      "VMs with Snapshots" "VMs without Snapshots" 
      "List DHCP IP Addresses (cannot be combined)" "<-- Back"
    )
    local height=$(( ${#options[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    mode=$(gum filter --height=$height --no-limit --header="Choose VM List Options> " \
      --selected="All VMs" "${options[@]}")
    opts=()
    case "$mode" in
      "All VMs") [[ " ${opts[*]} " != *" --all "* ]] && opts+=(--all) ;;
      "Autostart VMs") [[ " ${opts[*]} " != *" --autostart "* ]] && opts+=(--autostart) ;;
      "Running VMs") [[ " ${opts[*]} " != *" --state-running "* ]] && opts+=(--state-running) ;;
      "Stopped VMs") [[ " ${opts[*]} " != *" --state-shutoff "* ]] && opts+=(--state-shutoff) ;;
      "Paused VMs") [[ " ${opts[*]} " != *" --state-paused "* ]] && opts+=(--state-paused) ;;
      "VMs with Snapshots") [[ " ${opts[*]} " != *" --with-snapshots "* ]] && opts+=(--with-snapshots) ;;
      "VMs without Snapshots") [[ " ${opts[*]} " != *" --without-snapshots "* ]] && opts+=(--without-snapshots) ;;
      "List DHCP IP Addresses"*) mode=ip ;;
      "<-- Back") return ;;
      *) ;;
    esac
  fi

  if [[ "$mode" == ip ]]; then
    virsh "${connect[@]}" net-dhcp-leases "${1:-default}"
    exit
  fi

  virsh "${connect[@]}" list "${opts[@]}"
}

reboot_usage() {
  local label=${1:-reboot}
  shift
  echo "usage: ${0##*/} $label [Options] VM_NAME"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Do not ask for confirmation before ${label}ing"
  exit "${1:-0}"
}

reboot() {
  local mode=reboot mode_label=Reboot force=false pronoun=its vmlabel=VM vm="" REPLY=""
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="hucf:"
  local OPT_LONG=("help" "reset" "user" "session" "connect:" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      --reset) mode=reset ; mode_label="Hard Reset" ;;
      -h|--help) reboot_usage ${mode:-reboot} ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  if (( $# == 0 )); then
    gumcheck reboot_usage "$mode"
    local vms=() tmp=""
    mapfile -t vms < <(virsh "${connect[@]}" list --state-running --state-paused | awk 'NR>2&&/./{print $2}' 2> /dev/null | sort -n)
    (( ${#vms[@]} == 0 )) && { echo "No Running VMs" >&2 ; return ; }
    vms+=("<-- Back")
    local height=$(( ${#vms[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    mapfile -t vms < <(gum filter --height=$height --no-limit --header="Select VMs to $mode_label> " "${vms[@]}")
    if (( ${#vms[@]} == 0 )); then
      echo "Error getting VM to $mode_label" >&2
      exit 1
    fi
    for tmp in "${vms[@]}"; do
      [[ "$tmp" == "<-- Back" ]] && return
    done
    set -- "${vms[@]}"
    (( $# > 1 )) && { pronoun=their ; vmlabel=VMs ; }

    if ! "$force"; then
      tmp=$(gum choose --header="Really $mode_label $vmlabel ($*)? " No Yes)
      if [[ "$tmp" != "Yes" ]]; then
        echo "Not ${mode}ing $vmlabel: $*"
        return
      fi
    fi
  else
    if ! "$force"; then
      read -rp "Really $mode_label $vmlabel ($*)? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not ${mode}ing $vmlabel: $*"
        exit
      fi
      echo
    fi
  fi

  for vm in "$@"; do
    virsh "${connect[@]}" $mode "$vm"
  done
}

snapshot_usage() {
  echo "usage: ${0##*/} snapshot [Options] VM_NAME [SNAPSHOT_NAME]"
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  echo "  -f|--force          : Force delete with -D"
  echo "  -d|--description DESCR : Snapshot description (default: none)"
  echo "  -l|--list           : List snapshots for VM_NAME"
  echo "  -t|--list-tree      : List snapshots for VM_NAME (tree)"
  echo "  -D|--delete         : Delete SNAPSHOT_NAME snapshot for VM_NAME"
  echo "  -R|--revert         : Revert/restore VM_NAME to SNAPSHOT_NAME"
  exit "${1:-0}"
}

snapshot() {
  local mode=create vm="" snapshot_default="snapshot1" description="" force=false REPLY=""
  local desc=() disks=() disk_opt=() disk="" mem_opt=() gui_mode=true
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:fd:ltDR"
  local OPT_LONG=(
    "help" "user" "session" "connect:" "force" "description:" "list" "list-tree" "delete" "revert"
  )
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      -h|--help) snapshot_usage ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -d|--description) shift ; description=$1 ;;
      -f|--force) force=true ;;
      -l|--list) mode=list ;;
      -t|--list-tree) mode=list-tree ;;
      -D|--delete) mode=delete ;;
      -R|--revert) mode=revert ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  vm=$1
  snapshot=$2

  if [[ -z "$vm" ]]; then
    gumcheck snapshot_usage
    local vms=() tmp=""
    gui_mode=true
    mapfile -t vms < <(virsh "${connect[@]}" list --all | awk 'NR>2&&/./{print $2}' 2> /dev/null | sort -n)
    vms+=("<-- Back")
    local height=$(( ${#vms[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    if ! vm=$(gum filter --height=$height --header="Select VM to Manage Snapshots> " "${vms[@]}"); then
      echo "Error getting VM for Snapshot Management" >&2
      exit 1
    fi
    [[ -z "$vm" || "$vm" == "<-- Back" ]] && return
    tmp=$(gum filter --height=9 --header "Manage Snapshots for $vm" "Create Snapshot" "List Snapshots" \
      "List Snapshots (tree)" "Revert Snapshot" "Delete Snapshots")
    case "$tmp" in
      "Create Snapshot") mode=create ;;
      "List Snapshots") mode=list ;;
      "List Snapshots (tree)") mode="list-tree" ;;
      "Revert Snapshot") mode=revert ;;
      "Delete Snapshots") mode=delete ;;
      *) echo "Invalid mode for Snapshot Management ($tmp)" >&2 ; exit 1 ;;
    esac
  fi

  if [[ "$mode" == list ]]; then
    virsh "${connect[@]}" snapshot-list "$vm"
    return
  elif [[ "$mode" == list-tree ]]; then
    virsh "${connect[@]}" snapshot-list "$vm" --tree
    return
  fi

  if [[ "$mode" == delete ]]; then
    if $gui_mode; then
      local list=()
      mapfile -t list < <(virsh "${connect[@]}" snapshot-list --name "$vm" | grep . 2> /dev/null)
      list+=("hi" "there")
      local height=$(( ${#list[@]} + 4 ))
      if (( height < 5 )); then
        height=5
      elif (( height > 15 )); then
        height=15
      fi
      snapshot=$(gum filter --height=$height --no-limit --header="Choose snapshot(s) to Delete> " "${list[@]}")
      [[ -z "$snapshot" ]] && return
      if ! "$force"; then
        tmp=$(gum choose --header="Really Delete snapshot '$snapshot' for $vm? " No Yes)
        if [[ "$tmp" != "Yes" ]]; then
          echo "Not deleting '$snapshot' for $vm"
          return
        fi
      fi
    else
      if [[ -z "$snapshot" ]]; then
        echo "Error: SNAPSHOT_NAME must be provided when using -D" >&2
        exit 1
      fi
      if ! "$force"; then
        read -rp "Really delete snapshot '$snapshot' for $vm? [yN] "
        if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
          echo "Not deleting '$snapshot' for $vm"
          exit
        fi
        echo
      fi
    fi
    virsh "${connect[@]}" snapshot-delete "$vm" "$snapshot"
    return
  fi

  if [[ "$mode" == revert ]]; then
    if $gui_mode; then
      local list=()
      mapfile -t list < <(virsh "${connect[@]}" snapshot-list "$vm" | awk 'NR>2&&/./{print $1}' 2> /dev/null)
      local height=$(( ${#list[@]} + 4 ))
      if (( height < 5 )); then
        height=5
      elif (( height > 15 )); then
        height=15
      fi
      snapshot=$(gum filter --height=$height --header="Choose snapshot to Revert> " "${list[@]}")
      [[ -z "$snapshot" ]] && return
      if ! "$force"; then
        tmp=$(gum choose --header="Really Revert snapshot '$snapshot' for $vm? " No Yes)
        if [[ "$tmp" != "Yes" ]]; then
          echo "Not reverting '$snapshot' for $vm"
          return
        fi
      fi
    else
      if [[ -z "$snapshot" ]]; then
        echo "Error: SNAPSHOT_NAME must be provided when using -R" >&2
        exit 1
      fi
      if ! "$force"; then
        read -rp "Really revert $vm to snapshot '$snapshot'? [yN] "
        if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
          echo "Not reverting $vm to '$snapshot'"
          exit
        fi
        echo
      fi
    fi
    virsh "${connect[@]}" snapshot-revert "$vm" "$snapshot"
    return
  fi

  mapfile -t disks < <(virsh "${connect[@]}" domblklist "$vm" --details | awk '$1=="file" && $2=="disk" {print $3}')

  for disk in "${disks[@]}"; do
    disk_opt+=(--diskspec "$disk,snapshot=external")
  done
  if (( ${#disk_opt[@]} == 0 )); then
    echo "Error: Could not determine disks for $vm" >&2
    exit 1
  fi

  [[ -z "$snapshot" ]] && snapshot=$snapshot_default

  if $gui_mode; then
    snapshot=$(gum input --value="$snapshot" --header="Enter name for new $vm snapshot> ")
    [[ -z "$snapshot" ]] && return
    description=$(gum write --value="$description" --header="Enter description for new $vm snapshot> ")
  fi

  if [[ -n "$description" ]]; then
    desc=(--description "$description")
  fi

  # shellcheck disable=SC2174
  [[ ! -d /var/lib/libvirt/qemu/snapshot/"$vm" ]] &&
    mkdir -m 775 -p /var/lib/libvirt/qemu/snapshot/"$vm"

  if ! grep -q "shut off" < <(virsh "${connect[@]}" domstate "$vm"); then
    mem_opt=(--memspec "/var/lib/libvirt/qemu/snapshot/$vm/$snapshot-memory,snapshot=external")
  fi

  virsh "${connect[@]}" snapshot-create-as "$vm" --name "$snapshot" "${desc[@]}" \
    --atomic "${disk_opt[@]}" "${mem_opt[@]}"
}

start_usage() {
  local label=${1:-start}
  shift
  echo "usage: ${0##*/} $label [Options] VM_NAME.."
  echo
  echo "Options:"
  echo "  -h|--help           : This help text"
  echo "  -u|--user|--session : Connect to hypervisor with libvirt user/session URI (default: system URI)"
  echo "  -c|--connect URI    : Connect to hypervisor with libvirt URI (e.g.: -c qemu:///otherhost.example.com)"
  [[ "$label" == start ]] && echo "  -C|--console        : Start and attach to console"
  [[ "$label" == stop  ]] && echo "  -f|--force          : Stop VM(s) without prompting"
  exit "${1:-0}"
}

start() {
  local mode=start mode_label=Start command=start force=false
  local states=(--state-shutoff --state-paused) opts=()
  local connect=(--connect "$CONNECT_URI")
  local OPT_SHORT="huc:Cf"
  local OPT_LONG=("help" "stop" "user" "session" "connect:" "console" "force")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET
  while true; do
    case $1 in
      --stop) mode=stop ; mode_label=Stop ; command=destroy states=(--state-running --state-paused) ;;
      -h|--help) start_usage "${mode:-start}" ;;
      -u|--user|--session) connect=(--connect qemu:///session) ;;
      -c|--connect) shift ; connect=(--connect "$1") ;;
      -C|--console) opts+=(--console) ;;
      -f|--force) force=true ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  if (( $# == 0 )); then
    gumcheck start_usage "$mode"
    local vms=() tmp=""
    mapfile -t vms < <(virsh "${connect[@]}" list "${states[@]}" | awk 'NR>2&&/./{print $2}' 2> /dev/null | sort -n)
    vms+=("<-- Back")
    local height=$(( ${#vms[@]} + 4 ))
    if (( height < 5 )); then
      height=5
    elif (( height > 15 )); then
      height=15
    fi
    (( ${#vms[@]} == 0 )) && { echo "No available VMs" >&2 ; return ; }
    mapfile -t vms < <(gum filter --height=$height --no-limit --header="Select VM to $mode_label> " "${vms[@]}")
    if (( ${#vms[@]} == 0 )); then
      echo "Error getting VM to $mode_label" >&2
      exit 1
    fi
    for tmp in "${vms[@]}"; do
      [[ "$tmp" == "<-- Back" ]] && return
    done
    set -- "${vms[@]}"

    if [[ "$mode" == stop ]] && ! "$force"; then
      tmp=$(gum choose --header="Really $mode_label $vmlabel ($*)? " No Yes)
      if [[ "$tmp" != "Yes" ]]; then
        echo "Not ${mode}ing $vmlabel: $*"
        return
      fi
    fi
  else
    if [[ "$mode" == stop ]] && ! "$force"; then
      read -rp "Really $mode_label $vmlabel ($*)? [yN] "
      if [[ ! "$REPLY" =~ ^(YES|Yes|yes|Y|y|1)$ ]]; then
        echo "Not ${mode}ing $vmlabel: $*"
        exit
      fi
      echo
    fi
  fi

  if (( $# > 1 )) && [[ "$mode" == start && " ${opts[*]} " == *" --console "* ]]; then
    echo "Warning: Cannot automatically attach to the console when ${mode}ing multiple VMs" >&2
    local new_opts=() item=""
    for item in "${opts[@]}"; do
      [[ "$item" != --console ]] && new_opts+=("$item")
    done
    opts=("${new_opts[@]}")
  fi
  [[ "$mode" == stop ]] && opts=()

  for vm in "$@"; do
    virsh "${connect[@]}" $command "$vm" "${opts[@]}"
  done
}

get_os_variant() {
  command -v virt-install &>/dev/null || { echo "Error: virt-install is required for this program" >&2 ; exit 1 ; }

  (( $# < 1 )) && { echo "usage: get_os_variant SEARCHSTRING" ; return 1 ; }
  virt-install --osinfo list | \
    awk -F, -v os="$1" '$0 ~ "^" os "([[:digit:]]|$)" { print $1 }' | \
    sort -V | \
    tail -n1
}

get_iso() {
  (( $# < 1 )) && { echo "usage: get_iso ISOSEARCH [VM_ISO]" ; return 1 ; }
  local iso_search=$1 vm_iso=$2 ng=false
  if [[ -z "$vm_iso" ]]; then
    shopt -q nullglob && ng=true ; shopt -u nullglob
    for iso in "$ISO_PATH"/$iso_search; do
      vm_iso=$(printf "%s\n%s\n" "$vm_iso" "$iso" | grep . | sort -V | tail -n1)
    done
    $ng && shopt -s nullglob ; ng=false
  fi
  [[ -z "$vm_iso"   ]] && { echo "Error: ISO not defined" ; exit 1 ; }
  [[ ! -r "$vm_iso" ]] && { echo "Error: ISO not found"   ; exit 1 ; }
  echo "$vm_iso"
}

main_usage() {
  echo "usage: ${0##*/} MODE"
  echo
  echo "MODE can be:"
  echo "  clone    = Create clone of VM  : ${0##*/} clone [-h] [-u|-c URI] [-s|-S] SRC_VM DEST_VM"
  echo "  create   = Create a new VM     : ${0##*/} create [-h] [-A|-D|-F|-G|-O|-Q] [-n NAME] [-r RAM] [-v CPU] [-d DISKSZ] [-i ISO] [-g] [-T]"
  echo "  delete   = Delete/Destroy VM   : ${0##*/} delete [-h] [-f] VM_TO_DELETE"
  echo "  list     = List VMs            : ${0##*/} list [-h] [-a] [-A] [-r] [-o] [-p] [-s] [-S] [-i] NETWORK]"
  echo "  reboot   = Reboot guest        : ${0##*/} reboot [-h]"
  echo "  reset    = Forceably reset VM  : ${0##*/} reset [-h]"
  echo "  snapshot = Manage VM snapshots : ${0##*/} snapshot [-h] [-f] [-d DESC] [-l] [-t] [-D] [-R] VM_NAME [SNAPSHOT_NAME]"
  echo "  start    = Start VM            : ${0##*/} start [-h] [-c] VM_NAME"
  echo "  stop     = Stop VM             : ${0##*/} stop [-h] [-f] VM_NAME"
  echo "  help     = This help"
  if command -v gum &>/dev/null; then
    echo "If mode is not given and Gum* is installed, an interactive menu will be used"
    echo "* https://github.com/charmbracelet/gum"
  fi
  exit "${1:-0}"
}

main() {
  command -v virsh &>/dev/null || { echo "Error: virsh is required for this program" >&2 ; exit 1 ; }

  local use_gui=false action=$1 local actions=()
  [[ -z "$action" ]] && use_gui=true

  while : ; do
    if $use_gui; then
      gumcheck main_usage
      actions=(
        "Start VM(s)" "Stop VM(s)" "Create VM" "Clone VM" "Delete VM(s)"
        "VM Snapshots" "Reboot VM(s)" "Hard Reset VM(s)" "List VMs"
        "Quit"
      )
      action=$(gum filter --height=$(( ${#actions[@]} + 4 )) \
        --header="Virtual Machine Management> " "${actions[@]}")
      [[ -z "$action" ]] && exit
    fi

    case "$action" in
      "Clone VM"|clone|copy|duplicate|dupe) shift ; clone "$@" ;;
      "Create VM"|create|new) shift ; create "$@" ;;
      "Delete VM(s)"|delete|del|remove|rm) shift ; delete "$@" ;;
      "List VMs"|list|ls) shift ; list "$@" ;;
      "Reboot VM(s)"|reboot) shift ; reboot "$@" ;;
      "Reset VM(s)"|reset) shift ; reboot --reset "$@" ;;
      "VM Snapshots"|snapshot|snap) shift ; snapshot "$@" ;;
      "Start VM(s)"|start) shift ; start "$@" ;;
      "Stop VM(s)"|stop|shutdown|destroy) shift ; start --stop "$@" ;;
      "Quit") exit ;;
      ''|help|--help|-h)
        shift
        case "$1" in
          clone|copy|duplicate|dupe) clone -h ;;
          create|new) create -h ;;
          delete|del|remove|rm) delete -h ;;
          list|ls) list -h ;;
          reboot) reboot -h ;;
          reset) reboot --reset -h ;;
          snapshot|snap) snapshot -h ;;
          start) start -h ;;
          stop|shutdown|destroy) start --stop -h ;;
          *) main_usage ;;
        esac
        ;;
      -*) create "$@" ;;
      *) echo "Error: Invalid command" >&2 ; main_usage 1
    esac

    ! "$use_gui" && break
  done
}

main "$@"

