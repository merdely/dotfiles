#!/usr/bin/env bash

# Install binary files from GitHub projects of different types
# Supported types: tarball, zipfile, deb, rpm, pacman, and appimage
#
# For repos that need help, a configuration file (~/.config/software.conf by default)
# can contain settings:
# alias[ALIAS] allows running 'github-package ALIAS' (the rest of the settings point to the real repo)
# regex[REPO] gives a regex search string to find file amongst assets
# srcbin[REPO] gives a regex search string to find the binary to copy in the archive file
# bin[REPO] gives a filename for the destination file
# Variables in these settings can be expanded from {ARCH}, {SYSTEM}, and {STDLIB}
# ARCH: like x86_64, amd64, arm64, aarch64
# STDLIB: like glibc, gnu, musl
# SYSTEM: like openbsd, linux
#
# Example:
#   alias[atuin]=atuinsh/atuin
#   alias[alloy]=grafana/alloy
#   regex[atuinsh/atuin]='/atuin-{ARCH}-unknown-{SYSTEM}-{STDLIB}\.tar\.gz$'
#   regex[grafana/alloy]='/alloy-{SYSTEM}-{ARCH}\.zip$'
#   srcbin[grafana/alloy]='alloy-{SYSTEM}-{ARCH}'
#   type[neovim/neovim]=appimage

CONFIG="$HOME"/.config/software.conf

TMPFILES=()
cleanup() {
  local exit_code=$?
  rm -Rf -- "${TMPFILES[@]}"
  exit "$exit_code"
}
trap "cleanup" EXIT
trap "exit 1" INT TERM

usage() {
  echo "usage: ${0##*/} [Options] REPO"
  echo
  echo "Options:"
  echo "  -h|--help          : this help text"
  echo "  -v|--verbose       : print verbose messages"
  echo "  -c|--config ARG    : Configuration file (default: ${CONFIG/$HOME/\$HOME})"
  echo "  -s|--system        : System install in /usr/local/bin"
  echo "  -u|--user          : User install in \$HOME/.local/bin (default)"
  echo "  -U|--upgrade       : Upgrade existing package (default: do not overwrite)"
  echo "  -t|--tar           : Search for a tarball archive (default)"
  echo "  -z|--zip           : Search for a zipfile archive"
  echo "  -x|--executable    : Search for an executable file"
  echo "  -d|--deb           : Search for a Debian package"
  echo "  -r|--rpm           : Search for a Red Hat package"
  echo "  -p|--pacman        : Search for a Arch Linux package"
  echo "  -a|--appimage      : Search for a App Image"
  echo "     --server SERVER : Install/update app on SERVER"
  echo "     --arch ARCH     : Specify an alternate architecture (x86_64, amd64, arm64, aarch64)"
  echo "     --stdlib STDLIB : Specify an alternate standard library (gnu/glibc or musl)"
  echo "     --dest DEST     : Specify an alternate destination directory (use --system if sudo needed)"
  echo "     --test          : Print what would happen instead of installing"
  echo "     --debug         : Print debugging information"
  exit "${1:-0}"
}

main() {
  # _LIB="/../lib"            # comment this line out if parseopts.sh is in the same directory as $0
  # _LIBDIR=/srv/scripts/lib  # Use a line like this to override location of parseopts.sh
  local PARSEOPTS="${_LIBDIR:-"$(dirname "$0")${_LIB:-}"}/parseopts.sh"
  # shellcheck disable=SC1090,SC1091
  source "$PARSEOPTS" ; unset _LIB _LIBDIR

  local OPT_SHORT="hvc:suUtzxdrpa"
  local OPT_LONG=("help" "verbose" "system" "user" "upgrade" "test" "debug"
    "config:" "tar" "zip" "executable" "deb" "rpm" "pacman" "appimage"
    "host:" "arch:" "stdlib:" "dest:")
  declare -a OPTRET
  parseopts "$OPT_SHORT" "${OPT_LONG[@]}" -- "$@" || exit 1
  set -- "${OPTRET[@]}" ; unset OPT_SHORT OPT_LONG OPTRET

  declare -A ext_regex
  ext_regex[tar]="(tar\.gz|tgz|tar.bz2|tbz2|tar)"
  ext_regex[zip]="(zip)"
  ext_regex[exec]=""
  ext_regex[deb]="(deb|deb\.gz|deb\.bz2)"
  ext_regex[rpm]="(rpm|rpm\.gz|rpm\.bz2)"
  ext_regex[pacman]="(pkg\.tar\.xz|pkg\.tar\.zst)"
  ext_regex[appimage]="(appimage|AppImage|APPIMAGE)"
  local destdir="$HOME"/.local/bin use_sudo=false debug=false debug_level=0
  local verbose=false default_type=tar testmode=() upgrade=false
  local altarch="" altdest="" altstdlib="" hosts=()
  while true; do
    case $1 in
      -h|--help)     usage ;;
      -v|--verbose)  verbose=true ;;
      -s|--system)   destdir=/usr/local/bin ; use_sudo=true ;;
      -u|--user)     destdir="$HOME"/.local/bin ; use_sudo=false ;;
      -U|--upgrade)  upgrade=true ;;
      -c|--config)   shift ; CONFIG=$1 ;;
      -t|--tar)      type=tar ;;
      -z|--zip)      type=zip ;;
      -x|--executable) type="exec" ;;
      -d|--deb)      type=deb ;;
      -r|--rpm)      type=rpm ;;
      -p|--pacman)   type=pacman ;;
      -a|--appimage) type=appimage ;;
         --host)     shift ; hosts+=("$1") ;;
         --arch)     shift ; altarch=$1 ;;
         --stdlib)   shift ; altstdlib=$1 ;;
         --dest)     shift ; altdest=$1 ;;
         --test)     testmode=("echo") ;;
         --debug)    debug=true ; (( debug_level++ )) ;;
      --) shift ; break ;;
      *) ;;
    esac
    shift
  done

  local debug_on=false
  [[ "$(set -o | awk '$1=="xtrace"{print $2}')" == on ]] && debug_on=true

  [[ "${#hosts}" -gt 1 && -n "$altarch" ]] && { echo "Error: Cannot use --arch with more than one --host" 2>&1 ; exit 1 ; }
  [[ "${#hosts}" -gt 1 && -n "$altstdlib" ]] && { echo "Error: Cannot use --stdlib with more than one --host" 2>&1 ; exit 1 ; }

  (( ${#hosts} == 0 )) && hosts=("localhost")

  for host in "${hosts[@]}"; do
    for app in "$@"; do
      process_update "$host" "$app"
    done
  done
}
  
process_update() {
  local host="$1" pkg="$2" arch="" system="" stdlib="" use_ssh=false

  [[ -z "$host" || -z "$pkg" ]] && { echo "Error: Function requires two arguments" >&2 ; return 1 ; }

  local hostname=""
  if command -v hostname &> /dev/null; then
    hostname=$(hostname -s)
  elif command -v hostname &> /dev/null; then
    hostname=$(hostnamectl hostname)
  else
    echo "Error: Could not determine hostname for localhost" >&2
    return 1
  fi
  host=${host%%.*}

  if [[ "$host" == localhost || "$host" == "$hostname" ]]; then
    host=$hostname
    arch=$(uname -m)
    system=$(uname -s | tr '[:upper:]' '[:lower:]')
    stdlib="(glibc|gnu)"
    ldd --version 2>&1 | grep -qi "musl" && stdlib=musl
  else
    use_ssh=true
    arch=$(ssh "$host" uname -m)
    system=$(ssh "$host" uname -s | tr '[:upper:]' '[:lower:]')
    stdlib="(glibc|gnu)"
    ssh "$host" ldd --version 2>&1 | grep -qi "musl" && stdlib=musl
  fi

  # If --arch was given, use it as the architecture
  [[ -n "$altarch" ]] && arch=$altarch
  # If --stdlib was given, use it as the stdlib
  [[ -n "$altstdlib" ]] && stdlib=$altstdlib

  case "$arch" in
    arm64|aarch64)  arch="(arm64|aarch64)" ;;
    amd64|x86_64|x64|'') arch="(amd64|x86_64|x64)" ;;
    *) echo "Error: $arch not implemented" >&2 ; exit 1 ;;
  esac

  declare -A repo alias regex bin srcbin type dest sudo
  local tmpdir="" url="" files=() matches=()
  tmpdir=$(mktemp -d)
  TMPFILES=("$tmpdir")

  # Set defaults for a package
  type[$pkg]=$default_type
  bin[$pkg]=${pkg##*/}
  dest[$pkg]=$destdir
  sudo[$pkg]=false
  "$use_sudo" && sudo[$pkg]=true

  # shellcheck disable=1090
  [[ -r "$CONFIG" ]] && source "$CONFIG"

  # If an alias is defined, use it
  if [[ -n "${alias[$pkg]}" ]]; then
    repo[$pkg]=${alias[$pkg]}
  else
    repo[$pkg]=$pkg
    # If a package was given as "neovim", look for "neovim/neovim"
    [[ "$pkg" != */* ]] && repo[$pkg]=$pkg/$pkg
  fi
  [[ -n "${host_arch[$host]}"   ]] && arch=${host_arch[$host]}
  [[ -n "${host_stdlib[$host]}" ]] && stdlib=${host_stdlib[$host]}
  local sudo_cmd=()
  sudo[$pkg]=$(tr '[:upper:]' '[:lower:]' <<< "${sudo[$pkg]}")
  if [[ "${sudo[$pkg]}" == true || "${sudo[$pkg]}" == yes ]]; then
    sudo_cmd=("sudo")
  fi

  # Do substitution for regex, if defined
  if [[ -n "${regex[$pkg]}" ]]; then
    regex[$pkg]=${regex[$pkg]//{STDLIB\}/"$stdlib"}
    regex[$pkg]=${regex[$pkg]//{ARCH\}/"$arch"}
    regex[$pkg]=${regex[$pkg]//{SYSTEM\}/"$system"}
  fi

  # Do substitution for srcbin
  [[ -z "${srcbin[$pkg]}" ]] && srcbin[$pkg]=${bin[$pkg]}
  srcbin[$pkg]=${srcbin[$pkg]//{STDLIB\}/"$stdlib"}
  srcbin[$pkg]=${srcbin[$pkg]//{ARCH\}/"$arch"}
  srcbin[$pkg]=${srcbin[$pkg]//{SYSTEM\}/"$system"}

  if "$debug"; then
    echo "host=$host"
    echo "pkg=$pkg"
    echo "use_ssh=$use_ssh"
    echo "repo=${repo[$pkg]}"
    echo "regex=${regex[$pkg]}"
    echo "srcbin=${srcbin[$pkg]}"
    echo "bin=${bin[$pkg]}"
    echo "type=${type[$pkg]}"
    echo "dest=${dest[$pkg]}"
    echo "sudo=${sudo[$pkg]}"
    echo "sudo_cmd=${sudo_cmd[*]}"
    echo "stdlib=$stdlib"
    echo "arch=$arch"
    echo "system=$system"
    echo
    (( debug_level > 1 )) && return
  fi

  if ! "$upgrade"; then
    if ! "$use_ssh" && [[ -e "${dest[$pkg]}"/"${bin[$pkg]}" ]]; then
      echo "Error: ${bin[$pkg]} is already installed" >&2
      exit 1
    elif "$use_ssh" && ssh "$host" test -e "${dest[$pkg]}"/"${bin[$pkg]}"; then
      echo "Error: ${bin[$pkg]} is already installed on $host" >&2
      exit 1
    fi
  fi

  if [[ -z "${release_search[$pkg]}" ]]; then
    if ! http_code=$(curl -w "%{http_code}" -sfLo "$tmpdir"/curl.out "https://api.github.com/repos/${repo[$pkg]}/releases/latest"); then
      echo "Error: Could not download latest release info from GitHub" >&2
      exit 1
    fi
  else
    if ! http_code=$(curl -w "%{http_code}" -sfLo "$tmpdir"/curl.out "https://api.github.com/repos/${repo[$pkg]}/releases"); then
      echo "Error: Could not download release info from GitHub" >&2
      exit 1
    fi
    newest_tag=$(awk -v m="${release_search[$pkg]}" '{while ( where = match($0, "\"tag_name\": *\"(" m ")\"", a) ) { print a[1] ; exit }}' "$tmpdir"/curl.out)
    [[ -z "$newest_tag" ]] && { echo "Error: Could not determine newest tag for ${release_search[$pkg]}" >&2 ; exit 1 ; }
    if ! http_code=$(curl -w "%{http_code}" -sfLo "$tmpdir"/curl.out "https://api.github.com/repos/${repo[$pkg]}/releases/tags/$newest_tag"); then
      echo "Error: Could not download release info from GitHub" >&2
      exit 1
    fi
  fi
  [[ "$http_code" != 2* ]] && { echo "Error: HTTP Error $http_code downloading release information" >&2 ; exit 1 ; }
  local repo_info="$tmpdir"/curl.out
  
  # Use awk to parse json, even when it's all on one line
  mapfile -t files < <(awk '
    {
      while ( where = match($0, "\"browser_download_url\": *\"([^\"]*)\"", a) ) {
        print a[1]
        sub(/"browser_download_url": *"[^"]*"/,"")
      }
    }' "$repo_info")

  if (( ${#files[@]} == 0 )); then
    echo "Error: Could not get a list of files from GitHub for ${repo[$pkg]}" >&2
    cat "$tmpdir"/curl.out >&2
    exit 1
  fi

  local ncm=false
  shopt -q nocasematch && ncm=true ; shopt -s nocasematch
  # If configuration file has an entry for its regex, use it
  if [[ -n "${regex[$pkg]}" ]]; then
    "$debug" && echo "DEBUG: Using configured regex: ${regex[$pkg]}" >&2
    "$debug" && set -x
    for url in "${files[@]}"; do
      [[ "$url" =~ ${regex[$pkg]} ]] && { matches+=("$url") ; break ; }
    done
    ! "$debug_on" && set +x

  # If no config entry, try to find it first with system and arch, then adding stdlib
  else
    "$debug" && echo "DEBUG: Using default regex" >&2
    "$debug" && set -x
    for url in "${files[@]}"; do
      [[ "$url" =~ ${system}.*${arch}.*\.${ext_regex[${type[$pkg]}]}$ ||
        "$url" =~ ${arch}.*${system}.*\.${ext_regex[${type[$pkg]}]}$ ]] && matches+=("$url")
    done
    ! "$debug_on" && set +x
    if (( ${#matches[@]} == 0 )); then
      echo "Error: Could not find a file matching $system + $arch" >&2
      exit 1
    elif (( ${#matches[@]} > 1 )); then
      "$verbose" && { echo "Warning: Found multiple matches ${#matches[@]}, narrowing with stdlib ($stdlib)" >&2 ; \
        printf 'multiple: %s\n' "${matches[@]}" ; }
      files=("${matches[@]}")
      matches=()
      for url in "${files[@]}"; do
        [[ "$url" =~ ${system}.*${arch}.*${stdlib}.*\.${ext_regex[${type[$pkg]}]}$ ||
          "$url" =~ ${system}.*${stdlib}.*${arch}.*\.${ext_regex[${type[$pkg]}]}$ ||
          "$url" =~ ${stdlib}.*${system}.*${arch}.*\.${ext_regex[${type[$pkg]}]}$ ||
          "$url" =~ ${stdlib}.*${arch}.*${system}.*\.${ext_regex[${type[$pkg]}]}$ ||
          "$url" =~ ${arch}.*${system}.*${stdlib}.*\.${ext_regex[${type[$pkg]}]}$ ||
          "$url" =~ ${arch}.*${stdlib}.*${system}.*\.${ext_regex[${type[$pkg]}]}$ ]] && matches+=("$url")
      done
      if (( ${#matches[@]} == 0 )); then
        echo "Error: Narrowing with stdlib gave zero results" >&2
        exit 1
      elif (( ${#matches[@]} > 1 )); then
        echo "Error: Could not narrow down file to download (${#matches[@]} results)" >&2
        printf '%s\n' "${matches[@]}"
        exit 1
      fi
    fi
  fi
  ! "$ncm" && shopt -u nocasematch ; ncm=false

  if (( ${#matches[@]} != 1 )); then
    echo "Error: Could not narrow down download url (${#matches[@]} matches)" >&2
    exit 1
  fi
  url=${matches[0]}
  [[ -z "$url" ]] && { echo "Error: Could not determine download_url for $pkg" >&2 ; exit 1 ; }

  local download_file="$tmpdir"/"${url##*/}"
  curl -sLo "$download_file" "$url"
  echo "Installing ${repo[$pkg]} ${bin[$pkg]}"

  local tmpfile=""
  case "${download_file##*/}" in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2)
      "$verbose" && echo "Extracting tarball"
      tar -C "$tmpdir" -xf "$download_file"
      srcfile=$(find "$tmpdir" -type f | grep -E "${srcbin[$pkg]}$")
      if [[ -z "$srcfile" ]]; then
        echo "Error: Could not find ${bin[$pkg]} from tarball" >&2
        find "$tmpdir" >&2
        exit 1
      fi
      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp)
        scp "$srcfile" "$host":"$tmpfile"
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
        ssh "$host" rm -f "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$srcfile" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$srcfile" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
      fi
      ;;
    *.zip)
      "$verbose" && echo "Extracting zipfile"
      unzip -q -d "$tmpdir" "$download_file"
      srcfile=$(find "$tmpdir" -type f | grep -E "${srcbin[$pkg]}$")
      if [[ -z "$srcfile" ]]; then
        echo "Error: Could not find ${bin[$pkg]} from zipfile" >&2
        exit 1
      fi
      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp)
        scp "$srcfile" "$host":"$tmpfile"
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
        ssh "$host" rm -f "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$srcfile" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$srcfile" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
      fi
      ;;
    *.appimage|*.AppImage)
      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp -d)
        scp "$download_file" "$host":"$tmpfile"/
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "${dest[$pkg]}"/"${download_file##*/}"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" ln -sf "${download_file##*/}" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
        ssh "$host" rm -Rf "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${bin[$pkg]} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "$altdest"
        else
          echo "Copying ${bin[$pkg]} to ${dest[$pkg]}"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "${dest[$pkg]}"/"${download_file##*/}"
          "${testmode[@]}" "${sudo_cmd[@]}" ln -sf "${download_file##*/}" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
      fi
      ;;
    *.deb|*.deb.gz|*.deb.bz2)
      [[ "${download_file##*/}" == *.deb.gz ]] && { gunzip "${download_file##*/}" ; download_file=${download_file%.gz} ; }
      [[ "${download_file##*/}" == *.deb.bz2 ]] && { bunzip "${download_file##*/}" ; download_file=${download_file%.bz2} ; }

      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp -d)
        scp "$srcfile" "$host":"$tmpfile"/
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" ssh "$host" sudo apt install -y "$tmpfile"/"${download_file##*/}"
        fi
        ssh "$host" rm -Rf "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" sudo apt install -y "${download_file}"
        fi
      fi
      ;;
    *.pkg.tar.xz|*.pkg.tar.zst)
      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp -d)
        scp "$srcfile" "$host":"$tmpfile"/
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" ssh "$host" sudo pacman -U "$tmpfile"/"${download_file##*/}"
        fi
        ssh "$host" rm -Rf "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" sudo pacman -U "${download_file}"
        fi
      fi
      ;;
    *.rpm|*.rpm.gz|*.rpm.bz2)
      [[ "${download_file##*/}" == *.rpm.gz ]] && { gunzip "${download_file##*/}" ; download_file=${download_file%.gz} ; }
      [[ "${download_file##*/}" == *.rpm.bz2 ]] && { bunzip "${download_file##*/}" ; download_file=${download_file%.bz2} ; }

      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp -d)
        scp "$srcfile" "$host":"$tmpfile"
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" ssh "$host" sudo dnf install -y "$tmpfile"/"${download_file##*/}"
        fi
        ssh "$host" rm -Rf "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "$altdest"
        else
          echo "Installing ${download_file##*/}"
          "${testmode[@]}" sudo dnf install -y "${download_file}"
        fi
      fi
      ;;
    *)
      if "$use_ssh"; then
        tmpfile=$(ssh "$host" mktemp -d)
        scp "$srcfile" "$host":"$tmpfile"
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" ssh "$host" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "$altdest"
        else
          echo "Copying ${download_file##*/} to ${dest[$pkg]}"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$tmpfile"/"${download_file##*/}" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
        ssh "$host" rm -Rf "$tmpfile"
      else
        if [[ -n "$altdest" ]]; then
          echo "Copying ${download_file##*/} to $altdest"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "$altdest"
        else
          echo "Copying ${download_file##*/} to ${dest[$pkg]}"
          "${testmode[@]}" "${sudo_cmd[@]}" install -m 755 "$download_file" "${dest[$pkg]}"/"${bin[$pkg]}"
        fi
      fi
      ;;

  esac
}

main "$@"
