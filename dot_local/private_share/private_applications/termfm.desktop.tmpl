# vim: set filetype=desktop :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.local/share/applications/termfm.desktop
# Or after editing, run: chezmoi re-add ~/.local/applications/termfm.desktop

[Desktop Entry]
{{ if lookPath "yazi" -}}
Exec=bash -c "$HOME/.local/bin/x-terminal-emulator --title Yazi -e --class termfm yazi"
{{ else if lookPath "ranger" -}}
Exec=bash -c "$HOME/.local/bin/x-terminal-emulator --title Yazi -e --class termfm ranger"
{{ end -}}
Name=Terminal File Manager
Icon=utilities-terminal
StartupNotify=false
Type=Application
X-KDE-GlobalAccel-CommandShortcut=true
