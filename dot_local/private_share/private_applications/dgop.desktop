# vim: set filetype=desktop :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.local/share/applications/dgop.desktop
# Or after editing, run: chezmoi re-add ~/.local/applications/dgop.desktop

[Desktop Entry]
Exec=/home/mike/.local/bin/x-terminal-emulator -e --class dgop dgop
Name=Dux Go Process Status (Top)
Icon=htop
StartupNotify=false
Type=Application
X-KDE-GlobalAccel-CommandShortcut=true
