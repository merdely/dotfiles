# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.ceres.local
# Or after editing, run: chezmoi re-add ~/.ceres.local

alias caddycheck='docker exec caddy caddy validate --config /etc/caddy/Caddyfile'
alias caddyfmt='docker exec caddy caddy fmt --overwrite --config /etc/caddy/Caddyfile'
alias caddylogs='docker logs -f caddy --since 1m'
alias caddyreload='docker exec caddy caddy reload --config /etc/caddy/Caddyfile'

alias authgen='docker run --rm -it authelia/authelia:latest authelia crypto hash generate pbkdf2 --random'
alias authconfig='sudoedit /srv/docker/authelia/config/configuration.yml'
alias authusers='sudoedit /srv/docker/authelia/config/users.yml'
alias authlogs='docker logs -f authelia --since 2m'

