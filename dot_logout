# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.logout
# Or after editing, run: chezmoi re-add ~/.logout

if [[ -n "$SSH_CONNECTION" && "$SSH_AUTH_SOCK_OLD" != "$HOME"/.ssh/ssh-agent.socket && -n "$SSH_AUTH_SOCK_OLD" && -S "$SSH_AUTH_SOCK_OLD" ]]; then
  ln -sf "$SSH_AUTH_SOCK_OLD" "$HOME"/.ssh/ssh-agent.socket
fi
