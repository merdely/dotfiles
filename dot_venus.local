# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.venus.local
# Or after editing, run: chezmoi re-add ~/.venus.local

alias vipl='vi ~/.profile.local'
[[ ":$PATH:" != *:/opt/scripts/bin:*  ]] && PATH=$PATH:/opt/scripts/bin
[[ ":$PATH:" != *:/opt/scripts/sbin:*  ]] && PATH=$PATH:/opt/scripts/sbin

[[ ":$PATH:" != *:/opt/homebrew/bin:*  ]] && PATH=/opt/homebrew/bin:$PATH
[[ ":$PATH:" != *:$HOME/bin:*  ]] && PATH=$HOME/bin:$PATH

alias update_scripts_on_mac='sudo /usr/local/scripts/sbin/update_scripts_on_mac'
alias clear='/usr/bin/clear;pfetch'
alias susplunk='sudo su - splunk'
alias brew='sudo -Hu holly /opt/homebrew/bin/brew'
alias upgrade_librewolf='sudo -Hu holly /opt/homebrew/bin/brew uninstall --cask librewolf ; sudo rm -Rf /Applications/LibreWolf.app/ ; sudo -Hu holly /opt/homebrew/bin/brew install --cask librewolf'
alias update_librewolf=upgrade_librewolf
alias sudoedit='sudo vim'

alias ls='ls --color -F'
