# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.sinope.local
# Or after editing, run: chezmoi re-add ~/.sinope.local

[ "$(tty)" = "/dev/tty1" ] && sway

[ -S "/run/user/$EUID/wayland-1" ] && export WAYLAND_DISPLAY=wayland-1
swaysock=$(find /run/user/$EUID -maxdepth 1 -name "sway-ipc.$EUID.*.sock")
alias qreboot="pkill swaybg ; sleep 1 ; sudo reboot.no-molly-guard"
alias reboot="pkill swaybg ; sleep 1 ; sudo reboot"

alias luakit='/usr/bin/firejail --join-or-start=luakit /usr/bin/luakit'

alias vik='vi $HOME/.local/bin/start_kiosk'

alias listwindows='swaymsg -t get_tree | grep app_id'

export NVIM_DISABLE_PLUGINS=1
