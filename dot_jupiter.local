# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.jupiter.local
# Or after editing, run: chezmoi re-add ~/.jupiter.local

alias intel_gpu_top='sudo intel_gpu_top'
alias itop='sudo /usr/bin/intel_gpu_top'
alias nvtop='sudo nvtop'
alias dmesg='sudo dmesg'

# Postgres aliases
unset psql pbash createdb dropdb createuser dropuser pg_dump pg_dumpall pg_restore
postgres_container=postgres-vchord
#postgres_container=database
# shellcheck disable=2139
alias psql="docker compose exec -it -u postgres $postgres_container psql"
# shellcheck disable=2139
alias pbash="docker compose exec -it -u postgres $postgres_container bash"
# shellcheck disable=2139
alias createdb="docker compose exec -it -u postgres $postgres_container createdb"
# shellcheck disable=2139
alias dropdb="docker compose exec -it -u postgres $postgres_container dropdb"
# shellcheck disable=2139
alias createuser="docker compose exec -it -u postgres $postgres_container createuser"
# shellcheck disable=2139
alias dropuser="docker compose exec -it -u postgres $postgres_container dropuser"
# shellcheck disable=2139
alias pg_dump="docker compose exec -it -u postgres $postgres_container pg_dump"
# shellcheck disable=2139
alias pg_dumpall="docker compose exec -it -u postgres $postgres_container pg_dumpall"
# shellcheck disable=2139
alias pg_restore="docker compose exec -it -u postgres $postgres_container pg_restore"
#psql() { docker compose exec -it -u postgres postgres psql "$@"; }
#pbash() { docker compose exec -it -u postgres postgres bash; }
#createdb() { docker compose exec -it -u postgres postgres createdb "$@"; }
#dropdb() { docker compose exec -it -u postgres postgres dropdb "$@"; }
#createuser() { docker compose exec -it -u postgres postgres createuser "$@"; }
#dropuser() { docker compose exec -it -u postgres postgres dropuser "$@"; }
#pg_dump() { docker compose exec -it -u postgres postgres pg_dump "$@"; }
#pg_dumpall() { docker compose exec -it -u postgres postgres pg_dumpall "$@"; }
#pg_restore() { docker compose exec -it -u postgres postgres pg_restore "$@"; }

alias mysql="docker compose exec -it -u mysql mysql mariadb"
alias mariadb="docker compose exec -it -u mysql mysql mariadb"
alias mysqldump="docker compose exec -it -u mysql mysql mariadb-dump"
alias mariadb-dump="docker compose exec -it -u mysql mysql mariadb-dump"

# alias upgrade_meilisearch='docker run --rm -v /srv/docker/meilisearch:/meili_data getmeili/meilisearch:latest meilisearch --experimental-dumpless-upgrade'
alias upgrade_meilisearch='docker compose pull meilisearch;docker compose rm -sf meilisearch;echo;echo "**********************************************************";echo "* Press Ctrl+C to exiting the upgrade-run of meilisearch *";echo "**********************************************************";echo;docker run --rm -v /srv/docker/meilisearch:/meili_data getmeili/meilisearch:latest meilisearch --experimental-dumpless-upgrade;docker compose up -d meilisearch; info2mqtt -n meilisearch; docker compose logs meilisearch'

alias pa='docker compose -f /srv/docker/compose.yaml exec ytdlp-shell /home/mike/bin/ytdl.py --print-album'
alias ytdl.py='docker compose -f /srv/docker/compose.yaml exec ytdlp-shell /home/mike/bin/ytdl.py'

alias forgejo_settings='sudoedit /srv/docker/forgejo/data/custom/conf/app.ini'

alias suvcheck='sudo su - -s /bin/bash vcheck'
alias sudockuser='sudo su - -s /bin/bash dockuser'

alias vcheck='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck'
alias vc='vcheck'
alias v='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -L all'
alias vd='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -D -L all'

alias ytdlpshell='docker compose exec ytdlp-shell bash -l'
alias ytdlpsh=ytdlpshell
alias ys=ytdlpshell

# Container commands
alias authelia='docker compose -f /srv/docker/compose.yaml exec authelia authelia'
alias gitea='docker compose -f /srv/docker/compose.yaml exec forgejo gitea'
alias forgejo='docker compose -f /srv/docker/compose.yaml exec forgejo gitea'
alias mariadb='docker compose -f /srv/docker/compose.yaml exec mariadb mariadb'
alias mysql='docker compose -f /srv/docker/compose.yaml exec mariadb mariadb'
alias navidrome='docker compose -f /srv/docker/compose.yaml exec navidrome /app/navidrome'
alias nginx='docker compose -f /srv/docker/compose.yaml exec nginx nginx'
alias redis-cli='docker compose -f /srv/docker/compose.yaml exec redis redis-cli'

alias authconfig='sudoedit /srv/docker/authelia/config/configuration.yml'
alias authgen='docker run --rm -it authelia/authelia:latest authelia crypto hash generate pbkdf2 --random'
alias authlog='docker compose logs -f authelia --since 2m'
alias authusers='sudoedit /srv/docker/authelia/config/users.yml'

alias caddycheck='docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile'
alias caddyfmt='docker compose exec caddy caddy fmt --overwrite --config /etc/caddy/Caddyfile'
alias caddylogs='docker compose logs -f caddy --since 1m'
alias caddyreload='docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile'

alias vif='sudoedit /srv/docker/forgejo/data/custom/conf/app.ini'
alias viq='sudoedit /srv/docker/qbittorrent/config/qBittorrent/qBittorrent.conf'

# shellcheck disable=2154
alias get_jitsi='u=$(curl -s https://api.github.com/repos/jitsi/docker-jitsi-meet/releases/latest | jq -r .tarball_url) && (cd /tmp; curl -LO "$u"); unset u'
