# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.jupiter.local
# Or after editing, run: chezmoi re-add ~/.jupiter.local

alias fd=fdfind
alias bat=batcat
alias cat=batcat

alias intel_gpu_top='sudo intel_gpu_top'
alias itop='sudo /usr/bin/intel_gpu_top'
alias nvtop='sudo nvtop'
alias dmesg='sudo dmesg'

# Postgres aliases
unset psql pbash createdb dropdb createuser dropuser pg_dump pg_dumpall pg_restore
postgres_container=postgres-vchord
#postgres_container=database
# shellcheck disable=2139
alias psql="docker exec -it -u postgres $postgres_container psql"
# shellcheck disable=2139
alias pbash="docker exec -it -u postgres $postgres_container bash"
# shellcheck disable=2139
alias createdb="docker exec -it -u postgres $postgres_container createdb"
# shellcheck disable=2139
alias dropdb="docker exec -it -u postgres $postgres_container dropdb"
# shellcheck disable=2139
alias createuser="docker exec -it -u postgres $postgres_container createuser"
# shellcheck disable=2139
alias dropuser="docker exec -it -u postgres $postgres_container dropuser"
# shellcheck disable=2139
alias pg_dump="docker exec -it -u postgres $postgres_container pg_dump"
# shellcheck disable=2139
alias pg_dumpall="docker exec -it -u postgres $postgres_container pg_dumpall"
# shellcheck disable=2139
alias pg_restore="docker exec -it -u postgres $postgres_container pg_restore"
#psql() { docker exec -it -u postgres postgres psql "$@"; }
#pbash() { docker exec -it -u postgres postgres bash; }
#createdb() { docker exec -it -u postgres postgres createdb "$@"; }
#dropdb() { docker exec -it -u postgres postgres dropdb "$@"; }
#createuser() { docker exec -it -u postgres postgres createuser "$@"; }
#dropuser() { docker exec -it -u postgres postgres dropuser "$@"; }
#pg_dump() { docker exec -it -u postgres postgres pg_dump "$@"; }
#pg_dumpall() { docker exec -it -u postgres postgres pg_dumpall "$@"; }
#pg_restore() { docker exec -it -u postgres postgres pg_restore "$@"; }

alias mysql="docker exec -it -u mysql mysql mariadb"
alias mariadb="docker exec -it -u mysql mysql mariadb"
alias mysqldump="docker exec -it -u mysql mysql mariadb-dump"
alias mariadb-dump="docker exec -it -u mysql mysql mariadb-dump"

# alias upgrade_meilisearch='docker run --rm -v /srv/docker/meilisearch:/meili_data getmeili/meilisearch:latest meilisearch --experimental-dumpless-upgrade'
alias upgrade_meilisearch='docker compose -f /srv/docker/jupiter_meilisearch/compose.yaml pull meilisearch;docker compose -f /srv/docker/jupiter_meilisearch/compose.yaml rm -sf meilisearch;echo;echo "**********************************************************";echo "* Press Ctrl+C to exiting the upgrade-run of meilisearch *";echo "**********************************************************";echo;docker run --rm -v /srv/docker/meilisearch:/meili_data getmeili/meilisearch:latest meilisearch --upgrade-db;docker compose -f /srv/docker/jupiter_meilisearch/compose.yaml up -d meilisearch; info2mqtt -n meilisearch; docker compose -f /srv/docker/jupiter_meilisearch/compose.yaml logs meilisearch'

alias pa='docker exec -it ytdlp-shell /home/mike/bin/ytdl.py --print-album'
alias ytdl.py='docker exec -it ytdlp-shell /home/mike/bin/ytdl.py'

alias forgejo_settings='sudoedit /srv/docker/jupiter_forgejo/data/custom/conf/app.ini'

alias suvcheck='sudo su - -s /bin/bash vcheck'
alias sudockuser='sudo su - -s /bin/bash dockuser'

alias vcheck='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck'
alias vc='vcheck'
alias v='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -L all'
alias vd='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -D -L all'

alias ytdlpshell='docker exec -it ytdlp-shell bash -l'
alias ytdlpsh=ytdlpshell
alias ys=ytdlpshell

# Container commands
alias authelia='docker exec -it authelia authelia'
alias gitea='docker exec -it forgejo gitea'
alias forgejo='docker exec -it forgejo gitea'
alias mariadb='docker exec -it mariadb mariadb'
alias mysql='docker exec -it mariadb mariadb'
alias navidrome='docker exec -it navidrome /app/navidrome'
alias nginx='docker exec -it nginx nginx'
alias redis-cli='docker exec -it redis redis-cli'

alias authconfig='sudoedit /srv/docker/jupiter_authelia/config/configuration.yml'
alias authgen='docker run --rm -it authelia/authelia:latest authelia crypto hash generate pbkdf2 --random'
alias authlog='docker logs -f authelia --since 2m'
alias authusers='sudoedit /srv/docker/jupiter_authelia/config/users.yml'

alias caddycheck='docker exec -it caddy caddy validate --config /etc/caddy/Caddyfile'
alias caddyfmt='docker exec -it caddy caddy fmt --overwrite --config /etc/caddy/Caddyfile'
alias caddylogs='docker exec -it -f caddy --since 1m'
alias caddyreload='docker exec -it caddy caddy reload --config /etc/caddy/Caddyfile'

alias vif='sudoedit /srv/docker/jupiter_forgejo/data/custom/conf/app.ini'
alias viq='sudoedit /srv/docker/jupiter_qbittorrent/config/qBittorrent/qBittorrent.conf'

# shellcheck disable=2154
alias get_jitsi='u=$(curl -s https://api.github.com/repos/jitsi/docker-jitsi-meet/releases/latest | jq -r .tarball_url) && (cd /tmp; curl -LO "$u"); unset u'

unset COMPOSE_FILE
