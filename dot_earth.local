# vim: set filetype=sh :
# NOTE: Do not edit this file directly
# Use: chezmoi edit ~/.earth.local
# Or after editing, run: chezmoi re-add ~/.earth.local

alias fd=fdfind
alias bat=batcat
alias cat=batcat

alias intel_gpu_top='sudo intel_gpu_top'
alias itop='sudo /usr/bin/intel_gpu_top'
alias nvtop='sudo nvtop'
alias dmesg='sudo dmesg'
alias cag='adguardcli clear'
alias ral='adguardcli refresh'

alias docker-build='docker compose exec -it docker-build /srv/docker/build/build'
alias fixvpn='docker compose exec -it media-gateway /scripts/fixvpn'
alias gwping='echo pinging from gateway; docker compose exec -it media-gateway ping 9.9.9.9'
alias proxyping='echo pinging from proxy; docker compose exec -it media-proxy ping 9.9.9.9'
alias qbtping='echo pinging from qbt; docker compose exec -it media-torrent ping 9.9.9.9'
alias log='sudo -u splunk /usr/bin/tail -F /opt/splunk/var/log/splunk/splunkd.log'

alias smtpctl='docker compose exec smtpd smtpctl'

export GIT_DISCOVERY_ACROSS_FILESYSTEM=1

alias authgen='docker run --rm -it authelia/authelia:latest authelia crypto hash generate pbkdf2 --random'
alias authconfig='sudoedit /srv/docker/authelia/config/configuration.yml'
alias authusers='sudoedit /srv/docker/authelia/config/users.yml'
alias authlog='docker compose logs -f authelia --since 2m'
alias forgejo_settings='sudoedit /srv/docker/forgejo/data/custom/conf/app.ini'

alias archbuild='docker compose -f /srv/docker/compose.yaml exec -u mike archbuild bash -l'
alias buildpkgs='docker compose -f /srv/docker/compose.yaml exec -u mike archbuild buildpkgs'
alias cleanlock='docker compose -f /srv/docker/compose.yaml exec -u mike archbuild rm -f /home/mike/.gnupg/public-keys.d/pubring.db.lock'

alias archarmbuild='docker compose -f /srv/docker/compose.yaml exec -u mike archarmbuild bash -l'
alias buildarmpkgs='docker compose -f /srv/docker/compose.yaml exec -u mike archarmbuild buildpkgs'

# alias find_conflicts='sudo -u syncthing find /srv/syncthing -name "*sync-conflict*"'
alias find_conflicts='sudo -u syncthing fdfind -HIg -t file "*sync-conflict*" /srv/syncthing'

if [ "${SHELL##*/}" = "zsh" ]; then
  hash -d logseq=/srv/syncthing/mike/Logseq/Mike\'s\ Notes 
  hash -d syncthing=/srv/syncthing
fi

# shellcheck disable=2154
alias update_latest='e=$(mktemp);o=/srv/docker/nginx/www/html/latest_versions/latest_versions.json; /usr/bin/flock -n $HOME/.cache/flock/info2mqtt_latest_json /srv/scripts/bin/info2mqtt -qjN latest > $o.new 2> $e; [ -s "$o.new" ] && mv "$o.new" "$o"; cat $e; rm -f $e $o.new; unset e o'

#alias vcheck='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck'
#alias vc='vcheck'
#alias v='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -v -o /var/lib/vcheck/all.json all'
#alias vu='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -U -v -o /var/lib/vcheck/all.json'
#alias vp='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -v -o /var/lib/vcheck/printer.json printer_ink_check'
#alias vr='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -v -o /var/lib/vcheck/remote_apps.json remote_apps'
#alias vru='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -U -v -o /var/lib/vcheck/remote_apps.json'
#alias vl='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -v -o /var/lib/vcheck/latest.json latest'
#alias vlu='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -U -v -o /var/lib/vcheck/latest.json'

alias vif='sudoedit /srv/docker/$(hostname -s)_forgejo/data/custom/conf/app.ini'

alias suvcheck='sudo su - -s /bin/bash vcheck'
alias vcheck='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck'
alias vc='vcheck'
alias v='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -L all'
alias vr='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -L remote_apps'
alias vl='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -L latest'
alias vd='sudo su - -s /bin/bash vcheck -- /srv/scripts/bin/vcheck -D -L all'

alias garage='docker exec garage /garage'

alias naemoncheck='docker exec naemon runuser -u naemon -- naemon -v /etc/naemon/naemon.cfg'
alias naemonreload='docker exec naemon pkill -P 1 -x naemon'

alias psql='docker exec -it -u postgres postgres env HISTSIZE=10000 HISTFILE=~/.psql_history psql'
alias pbash='docker exec -it -u postgres postgres bash'
alias pg_dump='docker exec -it -u postgres postgres pg_dump'
alias pg_dumpall='docker exec -it -u postgres postgres pg_dumpall'
alias pg_restore='docker exec -it -u postgres postgres pg_restore'
alias createuser='docker exec -it -u postgres postgres createuser'
alias dropuser='docker exec -it -u postgres postgres dropuser'
alias createdb='docker exec -it -u postgres postgres createdb'
alias dropdb='docker exec -it -u postgres postgres dropdb'

alias mariadb="docker compose exec -it -u mysql mysql mariadb"
alias mariadb-dump="docker compose exec -it -u mysql mysql mariadb-dump"

alias caddycheck='docker exec caddy caddy validate --config /etc/caddy/Caddyfile'
alias caddyfmt='docker exec caddy caddy fmt --overwrite --config /etc/caddy/Caddyfile'
alias caddylogs='docker logs -f caddy --since 1m'
alias caddyreload='docker exec caddy caddy reload --config /etc/caddy/Caddyfile'
alias influxdb3='docker exec influxdb env INFLUXDB3_AUTH_TOKEN="$INFLUXDB3_AUTH_TOKEN" influxdb3'

alias bat=batcat
alias nvim-bare='env NVIM_APPNAME=- nvim'
alias nvim-test='env NVIM_APPNAME=nvim-test nvim'

# export COMPOSE_FILE=/srv/docker/all/compose.yaml
unset COMPOSE_FILE
